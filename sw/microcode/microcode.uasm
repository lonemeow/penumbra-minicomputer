# Penumbra Microcode Source
#
# Dispatch addresses (computed by fetch unit from IR bits):
#   Format R: {00, op[4], op[3:0], 0}    → ×2 spacing
#     ALU (op[4]=0): 0x00–0x1E            16 instructions, 2 entries each
#     SYS (op[4]=1): 0x40–0x5E            16 instructions, 2 entries each
#   Format L: {01, op[2:0], 00}           → entries 0x20–0x3F (×4 spacing)
#   Format M: {10, L, sz[1:0], SE, 00}    → entries 0x80–0xBF (×4 spacing)
#   Format B: {11, 0000000}               → entry 0x60
#   Interrupt/fault entry:                → entry 0x70 (hardwired)
#
# Register address encoding:
#   IR_RD = format-dependent Rd, IR_RS = format-dependent Rs/Rb
#   R2–R15 = literal register number
#
# Assembler defaults (uasm.py applies these when not specified):
#   pc=NEXT, branch=FETCH
# All other fields default to 0 (hardware zero):
#   a_src=REG, alu=ADD, bmux=REG, wmux=RBUS, all enables off.

# ═══════════════════════════════════════════════════════════════
# Format R — ALU operations (0x00–0x1E, ×2 spacing)
# Dispatch: {00, 0, op[3:0], 0}
# ═══════════════════════════════════════════════════════════════

# ── ADD (op=0, dispatch=0x00) ─────────────────────────────────
.org 0x00
add:
  reg_a=IR_RD reg_b=IR_RS reg_w=IR_RD w_en=1 alu=ADD bmux=REG wmux=RBUS w_flags=1

# ── SUB (op=1, dispatch=0x02) ─────────────────────────────────
.org 0x02
sub:
  reg_a=IR_RD reg_b=IR_RS reg_w=IR_RD w_en=1 alu=SUB bmux=REG wmux=RBUS w_flags=1

# ── AND (op=2, dispatch=0x04) ─────────────────────────────────
.org 0x04
and:
  reg_a=IR_RD reg_b=IR_RS reg_w=IR_RD w_en=1 alu=AND bmux=REG wmux=RBUS w_flags=1

# ── OR (op=3, dispatch=0x06) ──────────────────────────────────
.org 0x06
or:
  reg_a=IR_RD reg_b=IR_RS reg_w=IR_RD w_en=1 alu=OR bmux=REG wmux=RBUS w_flags=1

# ── XOR (op=4, dispatch=0x08) ─────────────────────────────────
.org 0x08
xor:
  reg_a=IR_RD reg_b=IR_RS reg_w=IR_RD w_en=1 alu=XOR bmux=REG wmux=RBUS w_flags=1

# ── SHL (op=5, dispatch=0x0A) ─────────────────────────────────
.org 0x0A
shl:
  reg_a=IR_RD reg_b=IR_RS reg_w=IR_RD w_en=1 alu=SHL bmux=REG wmux=RBUS w_flags=1

# ── SHR (op=6, dispatch=0x0C) ─────────────────────────────────
.org 0x0C
shr:
  reg_a=IR_RD reg_b=IR_RS reg_w=IR_RD w_en=1 alu=SHR bmux=REG wmux=RBUS w_flags=1

# ── SAR (op=7, dispatch=0x0E) ─────────────────────────────────
.org 0x0E
sar:
  reg_a=IR_RD reg_b=IR_RS reg_w=IR_RD w_en=1 alu=SAR bmux=REG wmux=RBUS w_flags=1

# ── MOV (op=8, dispatch=0x10) ─────────────────────────────────
# Rd = Rs (pass A-bus through ALU)
.org 0x10
mov:
  reg_a=IR_RS reg_w=IR_RD w_en=1 alu=PASS_A wmux=RBUS

# ── NOT (op=9, dispatch=0x12) ─────────────────────────────────
# Rd = ~Rs
.org 0x12
not:
  reg_a=IR_RS reg_w=IR_RD w_en=1 alu=NOT wmux=RBUS w_flags=1

# ═══════════════════════════════════════════════════════════════
# Format L — Immediate operations (0x20–0x3F, ×4 spacing)
# Dispatch: {01, op[2:0], 00}
# ═══════════════════════════════════════════════════════════════

# ── LLI Rd, #imm16 (op=000, dispatch=0x20) ───────────────────
# Rd = zero_extend(imm16)
.org 0x20
lli:
  reg_w=IR_RD w_en=1 alu=PASS_B bmux=IMM wmux=RBUS imm_mode=ZERO_EXT

# ── LLIS Rd, #imm16 (op=001, dispatch=0x24) ──────────────────
# Rd = sign_extend(imm16)
.org 0x24
llis:
  reg_w=IR_RD w_en=1 alu=PASS_B bmux=IMM wmux=RBUS imm_mode=SIGN_EXT

# ── LUI Rd, #imm16 (op=010, dispatch=0x28) ───────────────────
# Rd = Rd | (imm16 << 16)
.org 0x28
lui:
  reg_a=IR_RD reg_w=IR_RD w_en=1 alu=OR bmux=IMM wmux=RBUS imm_mode=SHIFT_L16

# ── ADD Rd, #imm16 (op=011, dispatch=0x2C) ───────────────────
# Rd = Rd + zero_extend(imm16)   [assembler: ADD Rd, #imm → Format L]
.org 0x2C
inc:
  reg_a=IR_RD reg_w=IR_RD w_en=1 alu=ADD bmux=IMM wmux=RBUS imm_mode=ZERO_EXT w_flags=1

# ── SUB Rd, #imm16 (op=100, dispatch=0x30) ───────────────────
# Rd = Rd - zero_extend(imm16)   [assembler: SUB Rd, #imm → Format L]
.org 0x30
dec:
  reg_a=IR_RD reg_w=IR_RD w_en=1 alu=SUB bmux=IMM wmux=RBUS imm_mode=ZERO_EXT w_flags=1

# ── CMP Rd, #imm16 (op=101, dispatch=0x34) ──────────────────
# Flags = Rd - zero_extend(imm16), Rd not written   [assembler: CMP Rd, #imm → Format L]
.org 0x34
cmpi:
  reg_a=IR_RD alu=SUB bmux=IMM wmux=RBUS imm_mode=ZERO_EXT w_flags=1

# ═══════════════════════════════════════════════════════════════
# Format R — System operations (0x40–0x5E, ×2 spacing)
# Dispatch: {00, 1, op[3:0], 0}  (op[4]=1 → system zone)
# ═══════════════════════════════════════════════════════════════

# ── WRSYS Rd, #dev, #reg (op=16, dispatch=0x40) ──────────────
# Write register Rd to system register. A-bus carries Rd value,
# sys_cycle + sys_we tell the target device to latch it.
# Privileged — cpu_top blocks dispatch in user mode (VEC_PRIV trap).
.org 0x40
wrsys:
  reg_a=IR_RD sys_cycle=1 sys_we=1

# ── RDSYS Rd, #dev, #reg (op=17, dispatch=0x42) ──────────────
# Read system register into Rd. Two micro-ops:
#   Step 0: sys_cycle=1 puts device data on sysreg bus → cpu_top
#           muxes it onto mem_rdata → MDR captures it.
#   Step 1: writeback MDR to Rd.
# Privileged.
.org 0x42
rdsys:
  sys_cycle=1 mdr_load_mem=1 pc=HOLD branch=SEQ
  reg_w=IR_RD w_en=1 wmux=MDR

# ── BREAK (op=21, dispatch=0x4A) ──────────────────────────────
# Software breakpoint: intercepted at dispatch time by cpu_top.
# Triggers except_entry → VEC_BREAK exception (like IRQ/fault).
# This microcode entry is never reached — dispatch redirects to
# int_entry (0x70). Slot left empty intentionally.

# ── ERET (op=22, dispatch=0x4C) ───────────────────────────────
# Exception return via EPC/ESR: restore ESR then EPC.
# Privileged — must be in supervisor mode.
# Step 0: ESR → ALU PASS_A → R-bus → w_bus → sr_load
#         (restores NZCV flags, S and I mode bits)
# Step 1: EPC → A-bus → PC (jumps back to interrupted instruction)
.org 0x4C
rti:
  a_src=ESR alu=PASS_A sr_load=1 pc=HOLD branch=SEQ
  a_src=EPC pc=ABUS

# ── JMP Rs (op=24, dispatch=0x50) ────────────────────────────
# PC = Rs (register indirect jump; RET = JMP R13)
.org 0x50
jmp:
  reg_a=IR_RS pc=ABUS

# ── EI (op=25, dispatch=0x52) ────────────────────────────────
# Enable interrupts: SR.I = 1, delayed by one instruction (ei_shadow)
.org 0x52
ei:
  ei_set=1

# ── DI (op=26, dispatch=0x54) ────────────────────────────────
# Disable interrupts: SR.I = 0, immediate effect (privileged)
.org 0x54
di:
  di_set=1

# ── ERET Rd, Rs (op=27, dispatch=0x56) ───────────────────────
# Exception return to explicit context: SR ← Rd, PC ← Rs.
# Step 0: Rd → A-bus → ALU PASS_A → R-bus → w_bus → sr_load
# Step 1: Rs → A-bus → PC (jump to new context)
# Privileged.
.org 0x56
iret:
  reg_a=IR_RD alu=PASS_A sr_load=1 pc=HOLD branch=SEQ
  reg_a=IR_RS pc=ABUS

# ── RDSPR Rd, ESR (op=29, dispatch=0x5A) ──────────────────────
# Read ESR into Rd. Privileged.
# ESR → A-bus → ALU PASS_A → R-bus → Rd
.org 0x5A
rdspr_esr:
  a_src=ESR alu=PASS_A reg_w=IR_RD w_en=1 wmux=RBUS

# ── RDSPR Rd, EPC (op=30, dispatch=0x5C) ──────────────────────
# Read EPC into Rd. Privileged.
# EPC → A-bus → ALU PASS_A → R-bus → Rd
.org 0x5C
rdspr_epc:
  a_src=EPC alu=PASS_A reg_w=IR_RD w_en=1 wmux=RBUS

# ═══════════════════════════════════════════════════════════════
# Format B — Branches (0x60)
# ═══════════════════════════════════════════════════════════════

.org 0x60
branch:
  pc=OFFSET branch=BRT

# ── BL — Branch and Link (cond=1111, dispatch=0x62) ──────
# Two micro-ops:
#   Step 0: Save return address (PC+4) to R13 (link register)
#   Step 1: Branch to PC+offset (unconditionally)
.org 0x62
bl:
  reg_a=R15 bmux=CONST4 alu=ADD reg_w=R13 w_en=1 wmux=RBUS pc=HOLD branch=SEQ
  pc=OFFSET

# ═══════════════════════════════════════════════════════════════
# Exception/interrupt entry (0x70)
# Hardware has already saved EPC, ESR, set S=1, I=0
# via except_entry pulse. This micro-routine loads the vector
# address into PC to jump to the handler.
# ═══════════════════════════════════════════════════════════════

.org 0x70
int_entry:
  a_src=VECTOR pc=ABUS

# ═══════════════════════════════════════════════════════════════
# Format M — Memory load/store (0x80–0xBF, ×4 spacing)
# Dispatch: {10, L, sz[1:0], SE, 00}
#
# Memory access pattern (latency-agnostic via STALL):
#   Micro-op 0: MAR ← Rb + sext(offset)              [address compute]
#   Load:  STALL with mem_read + mdr_load_mem → Rd ← MDR     (3 micro-ops)
#   Store: MDR ← Rd → STALL mem_write → advance PC          (4 micro-ops)
# ═══════════════════════════════════════════════════════════════

# ── STW Rd, [Rb + #offset] (L=0, sz=10, SE=0, dispatch=0x90) ─
# Step 0: compute address, load MAR
# Step 1: load store data (Rd) into MDR via A-bus
# Step 2: initiate write, stall until accepted (MMU/bus may add latency)
# Step 3: advance PC
.org 0x90
stw:
  reg_a=IR_RS bmux=IMM imm_mode=SIGN_EXT alu=ADD mar_load=1 pc=HOLD branch=SEQ
  reg_a=IR_RD mdr_load_a=1 pc=HOLD branch=SEQ
  mem_write=1 mem_size=WORD pc=HOLD branch=STALL
  pc=NEXT

# ── LDW Rd, [Rb + #offset] (L=1, sz=10, SE=0, dispatch=0xB0) ─
# Step 0: compute address, load MAR
# Step 1: initiate read, stall until data ready, capture into MDR
# Step 2: write MDR to Rd, advance PC
.org 0xB0
ldw:
  reg_a=IR_RS bmux=IMM imm_mode=SIGN_EXT alu=ADD mar_load=1 pc=HOLD branch=SEQ
  mem_read=1 mem_size=WORD mdr_load_mem=1 pc=HOLD branch=STALL
  reg_w=IR_RD w_en=1 wmux=MDR
