; No alloca: reserved call frame, no per-call SP adjustment.
define i32 @fixed_frame_stack_args() {
; CHECK-LABEL: fixed_frame_stack_args:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    sub sp, 8
