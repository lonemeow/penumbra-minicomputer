; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=penumbra -O2 -verify-machineinstrs < %s | FileCheck %s

; 64-bit relational compares run CMP on the low words and CMPC on the high
; words, which leaves N, C and V as one subtraction of the whole values would.
; Only less-than and greater-or-equal read those alone, so greater-than and
; less-or-equal swap their operands, or step a constant: `x > -1` is
; `x >= 0`.  A constant whose low word is zero leaves the high words to
; decide, and equal high words leave the low words' borrow to decide.

declare void @f()

define void @br_slt(i64 %a, i64 %b) {
; CHECK-LABEL: br_slt:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    cmp r1, r3
; CHECK-NEXT:    cmpc r2, r4
; CHECK-NEXT:    bge .LBB0_2
; CHECK-NEXT:  // %bb.1: // %t
; CHECK-NEXT:    sub sp, 4
; CHECK-NEXT:    stw lr, [sp + 0] // 4-byte Folded Spill
; CHECK-NEXT:    bl f
; CHECK-NEXT:    ldw lr, [sp + 0] // 4-byte Folded Reload
; CHECK-NEXT:    add sp, 4
; CHECK-NEXT:  .LBB0_2: // %e
; CHECK-NEXT:    jmp lr
  %c = icmp slt i64 %a, %b
  br i1 %c, label %t, label %e
t:
  call void @f()
  br label %e
e:
  ret void
}

