; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    mov r3, r1
; CHECK-NEXT:    cmp r3, r2
; CHECK-NEXT:    bgt .LBB0_1
; CHECK-NEXT:  // %bb.2:
; CHECK-NEXT:    mov r1, zero
; CHECK-NEXT:    cmp r3, r2
; CHECK-NEXT:    blt .LBB0_4
; CHECK-NEXT:    b .LBB0_5
