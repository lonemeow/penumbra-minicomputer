; Three-way compare intrinsics from the optimizer's
; (a > b) - (a < b) qsort-comparator idiom.

declare i32 @llvm.scmp.i32.i32(i32, i32)
declare i32 @llvm.ucmp.i32.i32(i32, i32)
declare i32 @llvm.scmp.i32.i64(i64, i64)
declare i32 @llvm.ucmp.i32.i64(i64, i64)

define i32 @scmp_i32(i32 %a, i32 %b) {
; CHECK-LABEL: scmp_i32:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    lli r4, 1
; CHECK-NEXT:    cmp r1, r2
; CHECK-NEXT:    bgt .LBB0_2
; CHECK-NEXT:  // %bb.1:
; CHECK-NEXT:    mov r4, zero
; CHECK-NEXT:  .LBB0_2:
; CHECK-NEXT:    llis r3, -1
; CHECK-NEXT:    cmp r1, r2
; CHECK-NEXT:    blt .LBB0_4
; CHECK-NEXT:  // %bb.3:
; CHECK-NEXT:    mov r3, r4
; CHECK-NEXT:  .LBB0_4:
; CHECK-NEXT:    mov r1, r3
; CHECK-NEXT:    jmp lr
  %r = call i32 @llvm.scmp.i32.i32(i32 %a, i32 %b)
  ret i32 %r
}

define i32 @ucmp_i32(i32 %a, i32 %b) {
; CHECK-LABEL: ucmp_i32:
