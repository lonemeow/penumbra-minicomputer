; CHECK-NEXT:  // %bb.1:
; CHECK-NEXT:    mov r4, zero
; CHECK-NEXT:  .LBB1_2:
; CHECK-NEXT:    llis r3, -1
; CHECK-NEXT:    cmp r1, r2
; CHECK-NEXT:    bcc .LBB1_4
; CHECK-NEXT:  // %bb.3:
; CHECK-NEXT:    mov r3, r4
; CHECK-NEXT:  .LBB1_4:
; CHECK-NEXT:    mov r1, r3
; CHECK-NEXT:    jmp lr
  %r = call i32 @llvm.ucmp.i32.i32(i32 %a, i32 %b)
  ret i32 %r
}

