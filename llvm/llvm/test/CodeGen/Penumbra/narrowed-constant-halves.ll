; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=penumbra-unknown-none -O2 < %s | FileCheck %s

; Narrowing an i64 operation to i32 halves leaves halves whose operands turn
; out constant: the zero high word of a zero-extension or of a small constant.
; The post-legalizer combiner folds them, so no instruction computes `x ^ 0`,
; `x + 0` or `0 * C`.

; Each half is compared as `half ^ constant half`; with a zero constant only
; the OR of the halves remains.
define i1 @eq_zero(i64 %x) {
; CHECK-LABEL: eq_zero:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    or r2, r1
; CHECK-NEXT:    cmp zero, r2
; CHECK-NEXT:    mov r1, zero
; CHECK-NEXT:    adc r1, zero
; CHECK-NEXT:    jmp lr
  %r = icmp eq i64 %x, 0
  ret i1 %r
}

; The low half still compares against 5; the high half needs no XOR.
define i1 @eq_five(i64 %x) {
; CHECK-LABEL: eq_five:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    lli r3, 5
; CHECK-NEXT:    xor r3, r1
; CHECK-NEXT:    or r3, r2
; CHECK-NEXT:    cmp zero, r3
; CHECK-NEXT:    mov r1, zero
; CHECK-NEXT:    adc r1, zero
; CHECK-NEXT:    jmp lr
  %r = icmp eq i64 %x, 5
  ret i1 %r
}

; NetBSD's bintime2timespec: the zero-extended fraction's zero high word times
; 10^9 is not a multiply, and its product is not added to the high half.
define i32 @frac_to_nsec(i64 %frac) {
; CHECK-LABEL: frac_to_nsec:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    lli r1, 51712
; CHECK-NEXT:    lui r1, 15258
; CHECK-NEXT:    mulu r2, r1, r1
; CHECK-NEXT:    jmp lr
  %hi = lshr i64 %frac, 32
  %hi32 = trunc i64 %hi to i32
  %w = zext i32 %hi32 to i64
  %p = mul i64 %w, 1000000000
  %s = lshr i64 %p, 32
  %r = trunc i64 %s to i32
  ret i32 %r
}

; The constant's zero high word leaves one cross product, x_hi * 3.
define i64 @mul_3(i64 %x) {
; CHECK-LABEL: mul_3:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    lli r3, 3
; CHECK-NEXT:    mulu r1, r3, r3
; CHECK-NEXT:    mov r4, r2
; CHECK-NEXT:    shl r4, 1
; CHECK-NEXT:    add r2, r4
; CHECK-NEXT:    add r2, r3
; CHECK-NEXT:    jmp lr
  %r = mul i64 %x, 3
  ret i64 %r
}
