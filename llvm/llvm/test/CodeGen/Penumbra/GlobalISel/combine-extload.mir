# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=penumbra-unknown-none -run-pass=penumbra-postlegalizer-combiner -verify-machineinstrs %s -o - | FileCheck %s

# An i16 load followed by a zero-extending AND with 0xFFFF (the post-legalize
# shape of zext-of-load) collapses into a single G_ZEXTLOAD.

---
name:            zext_load_i16
legalized:       true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r1
    ; CHECK-LABEL: name: zext_load_i16
    ; CHECK: liveins: $r1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(p0) = COPY $r1
    ; CHECK-NEXT: [[ZEXTLOAD:%[0-9]+]]:_(s32) = G_ZEXTLOAD [[COPY]](p0) :: (load (s16))
    ; CHECK-NEXT: $r1 = COPY [[ZEXTLOAD]](s32)
    ; CHECK-NEXT: RET implicit $r1
    %0:_(p0) = COPY $r1
    %1:_(s32) = G_LOAD %0(p0) :: (load (s16))
    %2:_(s32) = G_CONSTANT i32 65535
    %3:_(s32) = G_AND %1, %2
    $r1 = COPY %3(s32)
    RET implicit $r1
...
