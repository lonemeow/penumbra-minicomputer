# RUN: llc -mtriple=penumbra-unknown-none -run-pass=penumbra-postlegalizer-combiner -verify-machineinstrs %s -o - | FileCheck %s

# Chain of two G_PTR_ADD ops with constant offsets collapses into one
# G_PTR_ADD with the summed offset.

---
name:            chain_two_constants
legalized:       true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r1
    ; CHECK-LABEL: name: chain_two_constants
    ; CHECK: liveins: $r1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(p0) = COPY $r1
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 32
    ; CHECK-NEXT: [[PTR_ADD:%[0-9]+]]:_(p0) = G_PTR_ADD [[COPY]], [[C]](s32)
    ; CHECK-NEXT: [[LOAD:%[0-9]+]]:_(s32) = G_LOAD [[PTR_ADD]](p0) :: (load (s32))
    ; CHECK-NEXT: $r1 = COPY [[LOAD]](s32)
    ; CHECK-NEXT: RET implicit $r1
    %0:_(p0) = COPY $r1
    %1:_(s32) = G_CONSTANT i32 20
    %2:_(p0) = G_PTR_ADD %0, %1(s32)
    %3:_(s32) = G_CONSTANT i32 12
    %4:_(p0) = G_PTR_ADD %2, %3(s32)
    %5:_(s32) = G_LOAD %4(p0) :: (load (s32))
    $r1 = COPY %5(s32)
    RET implicit $r1
...
