# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=penumbra-unknown-none -run-pass=legalizer -verify-machineinstrs %s -o - | FileCheck %s

# The s64 G_ICMP rule: equality narrows generically, and a relational compare
# becomes G_ICMP_PAIR in less-than or greater-or-equal form, or a compare of
# the high words alone when a constant right-hand side has a zero low word.

--- |
  define void @eq() { ret void }
  define void @slt() { ret void }
  define void @sgt_swaps() { ret void }
  define void @slt_zero() { ret void }
  define void @sgt_minus_one_steps() { ret void }
  define void @ugt_const_on_left() { ret void }
  define void @ult_const() { ret void }
  define void @sgt_max_swaps() { ret void }
...

---
name:            eq
body: |
  bb.0:
    liveins: $r1, $r2, $r3, $r4
    ; CHECK-LABEL: name: eq
    ; CHECK: liveins: $r1, $r2, $r3, $r4
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(s32) = COPY $r1
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(s32) = COPY $r2
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:_(s32) = COPY $r3
    ; CHECK-NEXT: [[COPY3:%[0-9]+]]:_(s32) = COPY $r4
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 0
    ; CHECK-NEXT: [[XOR:%[0-9]+]]:_(s32) = G_XOR [[COPY]], [[COPY2]]
    ; CHECK-NEXT: [[XOR1:%[0-9]+]]:_(s32) = G_XOR [[COPY1]], [[COPY3]]
    ; CHECK-NEXT: [[OR:%[0-9]+]]:_(s32) = G_OR [[XOR]], [[XOR1]]
    ; CHECK-NEXT: [[ICMP:%[0-9]+]]:_(s32) = G_ICMP intpred(eq), [[OR]](s32), [[C]]
    ; CHECK-NEXT: $r1 = COPY [[ICMP]](s32)
    ; CHECK-NEXT: RET implicit $r1
    %0:_(s32) = COPY $r1
    %1:_(s32) = COPY $r2
    %2:_(s32) = COPY $r3
    %3:_(s32) = COPY $r4
    %4:_(s64) = G_MERGE_VALUES %0(s32), %1(s32)
    %5:_(s64) = G_MERGE_VALUES %2(s32), %3(s32)
    %6:_(s1) = G_ICMP intpred(eq), %4(s64), %5
    %7:_(s32) = G_ZEXT %6(s1)
    $r1 = COPY %7(s32)
    RET implicit $r1
...

---
name:            slt
body: |
  bb.0:
    liveins: $r1, $r2, $r3, $r4
    ; CHECK-LABEL: name: slt
    ; CHECK: liveins: $r1, $r2, $r3, $r4
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(s32) = COPY $r1
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(s32) = COPY $r2
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:_(s32) = COPY $r3
    ; CHECK-NEXT: [[COPY3:%[0-9]+]]:_(s32) = COPY $r4
    ; CHECK-NEXT: [[ICMP_PAIR:%[0-9]+]]:_(s32) = G_ICMP_PAIR intpred(slt), [[COPY]](s32), [[COPY1]], [[COPY2]], [[COPY3]]
    ; CHECK-NEXT: $r1 = COPY [[ICMP_PAIR]](s32)
    ; CHECK-NEXT: RET implicit $r1
    %0:_(s32) = COPY $r1
    %1:_(s32) = COPY $r2
    %2:_(s32) = COPY $r3
    %3:_(s32) = COPY $r4
    %4:_(s64) = G_MERGE_VALUES %0(s32), %1(s32)
    %5:_(s64) = G_MERGE_VALUES %2(s32), %3(s32)
    %6:_(s1) = G_ICMP intpred(slt), %4(s64), %5
    %7:_(s32) = G_ZEXT %6(s1)
    $r1 = COPY %7(s32)
    RET implicit $r1
...

---
name:            sgt_swaps
body: |
  bb.0:
    liveins: $r1, $r2, $r3, $r4
    ; CHECK-LABEL: name: sgt_swaps
    ; CHECK: liveins: $r1, $r2, $r3, $r4
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(s32) = COPY $r1
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(s32) = COPY $r2
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:_(s32) = COPY $r3
    ; CHECK-NEXT: [[COPY3:%[0-9]+]]:_(s32) = COPY $r4
    ; CHECK-NEXT: [[ICMP_PAIR:%[0-9]+]]:_(s32) = G_ICMP_PAIR intpred(slt), [[COPY2]](s32), [[COPY3]], [[COPY]], [[COPY1]]
    ; CHECK-NEXT: $r1 = COPY [[ICMP_PAIR]](s32)
    ; CHECK-NEXT: RET implicit $r1
    %0:_(s32) = COPY $r1
    %1:_(s32) = COPY $r2
    %2:_(s32) = COPY $r3
    %3:_(s32) = COPY $r4
    %4:_(s64) = G_MERGE_VALUES %0(s32), %1(s32)
    %5:_(s64) = G_MERGE_VALUES %2(s32), %3(s32)
    %6:_(s1) = G_ICMP intpred(sgt), %4(s64), %5
    %7:_(s32) = G_ZEXT %6(s1)
    $r1 = COPY %7(s32)
    RET implicit $r1
...

---
name:            slt_zero
body: |
  bb.0:
    liveins: $r1, $r2
    ; CHECK-LABEL: name: slt_zero
    ; CHECK: liveins: $r1, $r2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(s32) = COPY $r2
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 0
    ; CHECK-NEXT: [[ICMP:%[0-9]+]]:_(s32) = G_ICMP intpred(slt), [[COPY]](s32), [[C]]
    ; CHECK-NEXT: $r1 = COPY [[ICMP]](s32)
    ; CHECK-NEXT: RET implicit $r1
    %0:_(s32) = COPY $r1
    %1:_(s32) = COPY $r2
    %2:_(s64) = G_MERGE_VALUES %0(s32), %1(s32)
    %3:_(s64) = G_CONSTANT i64 0
    %4:_(s1) = G_ICMP intpred(slt), %2(s64), %3
    %5:_(s32) = G_ZEXT %4(s1)
    $r1 = COPY %5(s32)
    RET implicit $r1
...

# InstCombine's form of `x >= 0`.
---
name:            sgt_minus_one_steps
body: |
  bb.0:
    liveins: $r1, $r2
    ; CHECK-LABEL: name: sgt_minus_one_steps
    ; CHECK: liveins: $r1, $r2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(s32) = COPY $r2
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 0
    ; CHECK-NEXT: [[ICMP:%[0-9]+]]:_(s32) = G_ICMP intpred(sge), [[COPY]](s32), [[C]]
    ; CHECK-NEXT: $r1 = COPY [[ICMP]](s32)
    ; CHECK-NEXT: RET implicit $r1
    %0:_(s32) = COPY $r1
    %1:_(s32) = COPY $r2
    %2:_(s64) = G_MERGE_VALUES %0(s32), %1(s32)
    %3:_(s64) = G_CONSTANT i64 -1
    %4:_(s1) = G_ICMP intpred(sgt), %2(s64), %3
    %5:_(s32) = G_ZEXT %4(s1)
    $r1 = COPY %5(s32)
    RET implicit $r1
...

# `(1 << 32) > x` is `x < 1 << 32`: the high word below one.
---
name:            ugt_const_on_left
body: |
  bb.0:
    liveins: $r1, $r2
    ; CHECK-LABEL: name: ugt_const_on_left
    ; CHECK: liveins: $r1, $r2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(s32) = COPY $r2
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 1
    ; CHECK-NEXT: [[ICMP:%[0-9]+]]:_(s32) = G_ICMP intpred(ult), [[COPY]](s32), [[C]]
    ; CHECK-NEXT: $r1 = COPY [[ICMP]](s32)
    ; CHECK-NEXT: RET implicit $r1
    %0:_(s32) = COPY $r1
    %1:_(s32) = COPY $r2
    %2:_(s64) = G_MERGE_VALUES %0(s32), %1(s32)
    %3:_(s64) = G_CONSTANT i64 4294967296
    %4:_(s1) = G_ICMP intpred(ugt), %3(s64), %2
    %5:_(s32) = G_ZEXT %4(s1)
    $r1 = COPY %5(s32)
    RET implicit $r1
...

---
name:            ult_const
body: |
  bb.0:
    liveins: $r1, $r2
    ; CHECK-LABEL: name: ult_const
    ; CHECK: liveins: $r1, $r2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(s32) = COPY $r1
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(s32) = COPY $r2
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 0
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(s32) = G_CONSTANT i32 1000
    ; CHECK-NEXT: [[ICMP_PAIR:%[0-9]+]]:_(s32) = G_ICMP_PAIR intpred(ult), [[COPY]](s32), [[COPY1]], [[C1]], [[C]]
    ; CHECK-NEXT: $r1 = COPY [[ICMP_PAIR]](s32)
    ; CHECK-NEXT: RET implicit $r1
    %0:_(s32) = COPY $r1
    %1:_(s32) = COPY $r2
    %2:_(s64) = G_MERGE_VALUES %0(s32), %1(s32)
    %3:_(s64) = G_CONSTANT i64 1000
    %4:_(s1) = G_ICMP intpred(ult), %2(s64), %3
    %5:_(s32) = G_ZEXT %4(s1)
    $r1 = COPY %5(s32)
    RET implicit $r1
...

# The maximum cannot step, so the operands swap instead.
---
name:            sgt_max_swaps
body: |
  bb.0:
    liveins: $r1, $r2
    ; CHECK-LABEL: name: sgt_max_swaps
    ; CHECK: liveins: $r1, $r2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(s32) = COPY $r1
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(s32) = COPY $r2
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 2147483647
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(s32) = G_CONSTANT i32 -1
    ; CHECK-NEXT: [[ICMP_PAIR:%[0-9]+]]:_(s32) = G_ICMP_PAIR intpred(slt), [[C1]](s32), [[C]], [[COPY]], [[COPY1]]
    ; CHECK-NEXT: $r1 = COPY [[ICMP_PAIR]](s32)
    ; CHECK-NEXT: RET implicit $r1
    %0:_(s32) = COPY $r1
    %1:_(s32) = COPY $r2
    %2:_(s64) = G_MERGE_VALUES %0(s32), %1(s32)
    %3:_(s64) = G_CONSTANT i64 9223372036854775807
    %4:_(s1) = G_ICMP intpred(sgt), %2(s64), %3
    %5:_(s32) = G_ZEXT %4(s1)
    $r1 = COPY %5(s32)
    RET implicit $r1
...
