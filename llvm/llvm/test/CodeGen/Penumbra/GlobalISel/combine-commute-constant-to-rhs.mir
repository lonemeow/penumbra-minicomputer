# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=penumbra-unknown-none -run-pass=penumbra-postlegalizer-combiner -verify-machineinstrs %s -o - | FileCheck %s

# A commutative binop with a constant on the LHS gets rewritten so the
# constant is on the RHS, which matches our ADDi/ANDi/... patterns.

---
name:            add_const_lhs
legalized:       true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r1
    ; CHECK-LABEL: name: add_const_lhs
    ; CHECK: liveins: $r1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(s32) = COPY $r1
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 42
    ; CHECK-NEXT: [[ADD:%[0-9]+]]:_(s32) = G_ADD [[COPY]], [[C]]
    ; CHECK-NEXT: $r1 = COPY [[ADD]](s32)
    ; CHECK-NEXT: RET implicit $r1
    %0:_(s32) = COPY $r1
    %1:_(s32) = G_CONSTANT i32 42
    %2:_(s32) = G_ADD %1, %0
    $r1 = COPY %2(s32)
    RET implicit $r1
...
