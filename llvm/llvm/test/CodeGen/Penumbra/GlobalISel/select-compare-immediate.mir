# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=penumbra-unknown-none -run-pass=instruction-select -verify-machineinstrs %s -o - | FileCheck %s

# A compare against a constant that does not fit the uimm16 immediate moves to
# the adjacent predicate and constant when those fit.  At the top of the
# unsigned range the step up wraps to a constant that fits, and the adjusted
# compare would mean the opposite, so it keeps its register.  The combiner
# folds these compares before selection, hence MIR.

--- |
  define void @sle_minus_one() { ret void }
  define void @ugt_max() { ret void }
  define void @ule_max() { ret void }
...
---
name:            sle_minus_one
legalized:       true
regBankSelected: true
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: sle_minus_one
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $r1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gpr_allocatable = COPY $r1
  ; CHECK-NEXT:   CMPi [[COPY]], 0, implicit-def $sr
  ; CHECK-NEXT:   BLT %bb.1, implicit $sr
  ; CHECK-NEXT:   B %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   RET
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   RET
  bb.0:
    liveins: $r1
    successors: %bb.1, %bb.2
    %0:gprbank(s32) = COPY $r1
    %1:gprbank(s32) = G_CONSTANT i32 -1
    %2:gprbank(s32) = G_ICMP intpred(sle), %0, %1
    G_BRCOND %2, %bb.1
    G_BR %bb.2
  bb.1:
    RET
  bb.2:
    RET
...
---
name:            ugt_max
legalized:       true
regBankSelected: true
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: ugt_max
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $r1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gpr_allocatable = COPY $r1
  ; CHECK-NEXT:   [[LLIS:%[0-9]+]]:gpr = LLIS -1
  ; CHECK-NEXT:   CMP [[COPY]], [[LLIS]], implicit-def $sr
  ; CHECK-NEXT:   BHI %bb.1, implicit $sr
  ; CHECK-NEXT:   B %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   RET
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   RET
  bb.0:
    liveins: $r1
    successors: %bb.1, %bb.2
    %0:gprbank(s32) = COPY $r1
    %1:gprbank(s32) = G_CONSTANT i32 -1
    %2:gprbank(s32) = G_ICMP intpred(ugt), %0, %1
    G_BRCOND %2, %bb.1
    G_BR %bb.2
  bb.1:
    RET
  bb.2:
    RET
...
---
name:            ule_max
legalized:       true
regBankSelected: true
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: ule_max
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $r1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gpr_allocatable = COPY $r1
  ; CHECK-NEXT:   [[LLIS:%[0-9]+]]:gpr = LLIS -1
  ; CHECK-NEXT:   CMP [[COPY]], [[LLIS]], implicit-def $sr
  ; CHECK-NEXT:   BLS %bb.1, implicit $sr
  ; CHECK-NEXT:   B %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   RET
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   RET
  bb.0:
    liveins: $r1
    successors: %bb.1, %bb.2
    %0:gprbank(s32) = COPY $r1
    %1:gprbank(s32) = G_CONSTANT i32 -1
    %2:gprbank(s32) = G_ICMP intpred(ule), %0, %1
