; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=penumbra -global-isel -verify-machineinstrs -O2 < %s \
; RUN:   | FileCheck %s

; Block placement follows branch probabilities: the likely successor falls
; through and the unlikely one moves out of the way.

declare void @cold_path(i32)
declare void @hot_path(i32)
declare void @fail(ptr) noreturn

; Weighted toward the false edge: the call on the true edge goes last.
define void @expect_false(i32 %x) {
; CHECK-LABEL: expect_false:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  // %bb.0: // %entry
; CHECK-NEXT:    sub sp, 8
; CHECK-NEXT:    stw r5, [sp + 4] // 4-byte Folded Spill
; CHECK-NEXT:    stw lr, [sp + 0] // 4-byte Folded Spill
; CHECK-NEXT:    cmp r1, 7
; CHECK-NEXT:    beq .LBB0_1
; CHECK-NEXT:  .LBB0_2: // %hot
; CHECK-NEXT:    bl hot_path
; CHECK-NEXT:    ldw lr, [sp + 0] // 4-byte Folded Reload
; CHECK-NEXT:    ldw r5, [sp + 4] // 4-byte Folded Reload
; CHECK-NEXT:    add sp, 8
; CHECK-NEXT:    jmp lr
; CHECK-NEXT:  .LBB0_1: // %cold
; CHECK-NEXT:    mov r5, r1
; CHECK-NEXT:    bl cold_path
; CHECK-NEXT:    mov r1, r5
; CHECK-NEXT:    b .LBB0_2
entry:
  %c = icmp eq i32 %x, 7
  br i1 %c, label %cold, label %hot, !prof !0
cold:
  call void @cold_path(i32 %x)
  br label %hot
hot:
  call void @hot_path(i32 %x)
  ret void
}

; Weighted toward the true edge: the call on the false edge goes last.
define void @expect_true(i32 %x) {
; CHECK-LABEL: expect_true:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  // %bb.0: // %entry
; CHECK-NEXT:    sub sp, 8
; CHECK-NEXT:    stw r5, [sp + 4] // 4-byte Folded Spill
; CHECK-NEXT:    stw lr, [sp + 0] // 4-byte Folded Spill
; CHECK-NEXT:    cmp r1, 7
; CHECK-NEXT:    bne .LBB1_1
; CHECK-NEXT:  .LBB1_2: // %hot
; CHECK-NEXT:    bl hot_path
; CHECK-NEXT:    ldw lr, [sp + 0] // 4-byte Folded Reload
; CHECK-NEXT:    ldw r5, [sp + 4] // 4-byte Folded Reload
; CHECK-NEXT:    add sp, 8
; CHECK-NEXT:    jmp lr
; CHECK-NEXT:  .LBB1_1: // %cold
; CHECK-NEXT:    mov r5, r1
; CHECK-NEXT:    bl cold_path
; CHECK-NEXT:    mov r1, r5
; CHECK-NEXT:    b .LBB1_2
entry:
  %c = icmp eq i32 %x, 7
  br i1 %c, label %hot, label %cold, !prof !1
cold:
  call void @cold_path(i32 %x)
  br label %hot
hot:
  call void @hot_path(i32 %x)
  ret void
}

; An assertion: a noreturn call makes its edge unlikely without metadata.
define i32 @assert_shape(ptr %p) {
; CHECK-LABEL: assert_shape:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  // %bb.0: // %entry
; CHECK-NEXT:    sub sp, 4
; CHECK-NEXT:    stw lr, [sp + 0] // 4-byte Folded Spill
; CHECK-NEXT:    ldw r2, [r1 + 0]
; CHECK-NEXT:    cmp r2, 0
; CHECK-NEXT:    blt .LBB2_2
; CHECK-NEXT:  // %bb.1: // %ok
; CHECK-NEXT:    add r2, 1
; CHECK-NEXT:    mov r1, r2
; CHECK-NEXT:    ldw lr, [sp + 0] // 4-byte Folded Reload
; CHECK-NEXT:    add sp, 4
; CHECK-NEXT:    jmp lr
; CHECK-NEXT:  .LBB2_2: // %failed
; CHECK-NEXT:    bl fail
entry:
  %v = load i32, ptr %p
  %bad = icmp slt i32 %v, 0
  br i1 %bad, label %failed, label %ok
failed:
  call void @fail(ptr %p)
  unreachable
ok:
  %r = add i32 %v, 1
  ret i32 %r
}

!0 = !{!"branch_weights", i32 1, i32 2000}
!1 = !{!"branch_weights", i32 2000, i32 1}
