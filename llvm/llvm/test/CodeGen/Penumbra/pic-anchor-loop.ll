; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=penumbra-unknown-netbsd -relocation-model=pic -O2 < %s | FileCheck %s

; A global's PIC address is loop-invariant, but it is materialized in the block
; that uses it, which here is the loop.  Loop-invariant code motion takes the
; whole sequence back out, the PC-reading ADD included: the anchor's label
; travels with it, and its flags are marked dead.

@table = hidden global [256 x i8] zeroinitializer
@gtable = global [256 x i8] zeroinitializer

; The PC-relative path of a non-preemptible global: nothing of the address is
; left in the loop.
define void @lookup_row(ptr %dst, ptr %src, i32 %n) {
; CHECK-LABEL: lookup_row:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  // %bb.0: // %entry
; CHECK-NEXT:    sub sp, 8
; CHECK-NEXT:    lli r4, %pcrel_lo16(table-.LPC0_0)
; CHECK-NEXT:    lui r4, %pcrel_hi16(table-.LPC0_0)
; CHECK-NEXT:  .LPC0_0:
; CHECK-NEXT:    add r4, pc
; CHECK-NEXT:    mov r11, zero
; CHECK-NEXT:    stw r5, [sp + 4] // 4-byte Folded Spill
; CHECK-NEXT:    stw lr, [sp + 0] // 4-byte Folded Spill
; CHECK-NEXT:  .LBB0_1: // %loop
; CHECK-NEXT:    // =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    mov lr, r2
; CHECK-NEXT:    add lr, r11
; CHECK-NEXT:    ldb r5, [lr + 0]
; CHECK-NEXT:    mov lr, r1
; CHECK-NEXT:    add r5, r4
; CHECK-NEXT:    ldb r5, [r5 + 0]
; CHECK-NEXT:    add lr, r11
; CHECK-NEXT:    add r11, 1
; CHECK-NEXT:    cmp r11, r3
; CHECK-NEXT:    stb r5, [lr + 0]
; CHECK-NEXT:    bcc .LBB0_1
; CHECK-NEXT:  // %bb.2: // %exit
; CHECK-NEXT:    ldw lr, [sp + 0] // 4-byte Folded Reload
; CHECK-NEXT:    ldw r5, [sp + 4] // 4-byte Folded Reload
; CHECK-NEXT:    add sp, 8
; CHECK-NEXT:    jmp lr
entry:
  br label %loop
loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  %s = getelementptr inbounds i8, ptr %src, i32 %i
  %x = load i8, ptr %s
  %xi = zext i8 %x to i32
  %t = getelementptr inbounds [256 x i8], ptr @table, i32 0, i32 %xi
  %v = load i8, ptr %t
  %d = getelementptr inbounds i8, ptr %dst, i32 %i
  store i8 %v, ptr %d
  %i.next = add nuw i32 %i, 1
  %c = icmp ult i32 %i.next, %n
  br i1 %c, label %loop, label %exit
exit:
  ret void
}

; The GOT path of a preemptible one: the read of the slot leaves the loop with
; the slot's address, since the read is marked as one that no store changes.
define void @lookup_row_got(ptr %dst, ptr %src, i32 %n) {
; CHECK-LABEL: lookup_row_got:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  // %bb.0: // %entry
; CHECK-NEXT:    sub sp, 8
; CHECK-NEXT:    lli r4, %got_pcrel_lo16(gtable-.LPC1_0)
; CHECK-NEXT:    lui r4, %got_pcrel_hi16(gtable-.LPC1_0)
; CHECK-NEXT:  .LPC1_0:
; CHECK-NEXT:    add r4, pc
; CHECK-NEXT:    ldw r4, [r4 + 0]
; CHECK-NEXT:    mov r11, zero
; CHECK-NEXT:    stw r5, [sp + 4] // 4-byte Folded Spill
; CHECK-NEXT:    stw lr, [sp + 0] // 4-byte Folded Spill
; CHECK-NEXT:  .LBB1_1: // %loop
; CHECK-NEXT:    // =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    mov lr, r2
; CHECK-NEXT:    add lr, r11
; CHECK-NEXT:    ldb r5, [lr + 0]
