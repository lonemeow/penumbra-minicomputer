; RUN: llc -mtriple=penumbra -O2 -verify-machineinstrs < %s | FileCheck %s

; Whether a wide constant is rebuilt where it is used or kept live is the
; tuned core's call, from its scheduling model: the LLI + LUI pair counts as
; cheap where it costs no more than its two instructions.  Penumbra/2 has no
; forwarding, so LUI waits three cycles for the LLI result and the constant
; stays live across the diamond; Penumbra/1 is serial and Penumbra/2.5
; forwards, so both rebuild it after the diamond.  llc has no -mtune, so each
; function names its core with a "tune-cpu" attribute.

define i32 @penumbra1(i32 %a, i32 %b, ptr %p) #0 {
; CHECK-LABEL: penumbra1:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  // %bb.0: // %entry
; CHECK-NEXT:    lli r4, 22136
; CHECK-NEXT:    lui r4, 4660
; CHECK-NEXT:    xor r4, r1
; CHECK-NEXT:    cmp r2, 0
; CHECK-NEXT:    beq .LBB0_1
; CHECK-NEXT:  // %bb.2: // %r
; CHECK-NEXT:    stw r2, [r3 + 0]
; CHECK-NEXT:    b .LBB0_3
; CHECK-NEXT:  .LBB0_1: // %l
; CHECK-NEXT:    stw r4, [r3 + 0]
; CHECK-NEXT:  .LBB0_3: // %join
; CHECK-NEXT:    add r2, r4
; CHECK-NEXT:    lli r1, 22136
; CHECK-NEXT:    lui r1, 4660
; CHECK-NEXT:    add r1, r2
; CHECK-NEXT:    jmp lr
entry:
  %x = xor i32 %a, 305419896
  %c = icmp eq i32 %b, 0
  br i1 %c, label %l, label %r
l:
  store i32 %x, ptr %p
  br label %join
r:
  store i32 %b, ptr %p
  br label %join
join:
  %y = add i32 %b, 305419896
  %z = add i32 %x, %y
  ret i32 %z
}

