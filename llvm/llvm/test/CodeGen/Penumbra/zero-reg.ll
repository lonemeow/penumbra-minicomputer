; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; RUN: llc -mtriple=penumbra -global-isel -verify-machineinstrs < %s \
; RUN:   | FileCheck %s

; Store of constant zero should use R0 directly, not materialize with LLI.
define void @store_zero_word(ptr %p) {
; CHECK-LABEL: store_zero_word:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    stw zero, [r1 + 0]
; CHECK-NEXT:    jmp lr
  store i32 0, ptr %p, align 4
  ret void
}

define void @store_zero_byte(ptr %p) {
; CHECK-LABEL: store_zero_byte:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    stb zero, [r1 + 0]
; CHECK-NEXT:    jmp lr
  store i8 0, ptr %p, align 1
  ret void
}

define void @store_zero_half(ptr %p) {
; CHECK-LABEL: store_zero_half:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    sth zero, [r1 + 0]
; CHECK-NEXT:    jmp lr
  store i16 0, ptr %p, align 2
  ret void
}

; Non-zero store should NOT use R0.
define void @store_nonzero(ptr %p) {
; CHECK-LABEL: store_nonzero:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    lli r2, 42
; CHECK-NEXT:    stw r2, [r1 + 0]
; CHECK-NEXT:    jmp lr
  store i32 42, ptr %p, align 4
  ret void
}

; A zero passed on both sides of a call is read from R0 at each use rather
; than held in a callee-saved register across the call, which would cost a
; save, a restore and a copy.  This works only because R0 is a *member* of
; the i32 value register class (PenumbraRegisterInfo.td's GPR_Allocatable),
; so the coalescer can substitute it for the selected `COPY $r0`.
declare void @use(i32)

define void @zero_across_call() {
; CHECK-LABEL: zero_across_call:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    sub sp, 4
; CHECK-NEXT:    mov r1, zero
; CHECK-NEXT:    stw lr, [sp + 0] // 4-byte Folded Spill
; CHECK-NEXT:    bl use
; CHECK-NEXT:    mov r1, zero
; CHECK-NEXT:    bl use
; CHECK-NEXT:    ldw lr, [sp + 0] // 4-byte Folded Reload
; CHECK-NEXT:    add sp, 4
; CHECK-NEXT:    jmp lr
  call void @use(i32 0)
  call void @use(i32 0)
  ret void
}
