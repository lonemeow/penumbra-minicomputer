}

; Left alone: the select has another use, so it stays either way.
define i32 @select_two_uses(i32 %x, i32 %a, i32 %k, ptr %q) {
; CHECK-LABEL: select_two_uses:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    cmp r2, 0
; CHECK-NEXT:    beq .LBB10_2
; CHECK-NEXT:  // %bb.1:
; CHECK-NEXT:    mov r3, zero
; CHECK-NEXT:  .LBB10_2:
; CHECK-NEXT:    stw r3, [r4 + 0]
; CHECK-NEXT:    sub r1, r3
; CHECK-NEXT:    jmp lr
  %c = icmp eq i32 %a, 0
  %s = select i1 %c, i32 %k, i32 0
  store i32 %s, ptr %q
  %r = sub i32 %x, %s
  ret i32 %r
}

; Left alone: a select made once outside the loop would become a branch on
; every iteration.
define i32 @select_outside_loop(i32 %a, i32 %k, i32 %n) {
; CHECK-LABEL: select_outside_loop:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  // %bb.0: // %entry
; CHECK-NEXT:    mov r4, r1
; CHECK-NEXT:    mov r1, zero
; CHECK-NEXT:    cmp r4, 0
; CHECK-NEXT:    beq .LBB11_2
; CHECK-NEXT:  // %bb.1: // %entry
; CHECK-NEXT:    mov r2, r1
; CHECK-NEXT:  .LBB11_2: // %loop
; CHECK-NEXT:    // =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    add r1, r2
; CHECK-NEXT:    sub r3, 1
; CHECK-NEXT:    bne .LBB11_2
; CHECK-NEXT:  // %bb.3: // %exit
; CHECK-NEXT:    jmp lr
entry:
  %c = icmp eq i32 %a, 0
  %s = select i1 %c, i32 %k, i32 0
  br label %loop
loop:
  %i = phi i32 [ 0, %entry ], [ %i1, %loop ]
  %x = phi i32 [ 0, %entry ], [ %x1, %loop ]
  %x1 = add i32 %x, %s
  %i1 = add i32 %i, 1
  %d = icmp eq i32 %i1, %n
  br i1 %d, label %exit, label %loop
exit:
  ret i32 %x1
}
