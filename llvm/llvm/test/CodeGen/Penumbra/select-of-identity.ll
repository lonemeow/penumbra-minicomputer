; CHECK-NEXT:  .LBB9_2:
; CHECK-NEXT:    sub r3, r1
; CHECK-NEXT:    mov r1, r3
; CHECK-NEXT:    jmp lr
  %c = icmp eq i32 %a, 0
  %s = select i1 %c, i32 %k, i32 0
