; `if (c) x op= k` reaches the backend as `x op select(c, id, k)`, with id the
; operation's identity.  Penumbra has no conditional move, so the select is a
; branch, and the operation belongs in the arm that is not the identity: the
; other path leaves x as it is.

; The loop wrap of a tracker mixer's sample position.
define i32 @wrap_sub(i32 %pos, i32 %inc, i32 %lim, i32 %k) {
; CHECK-LABEL: wrap_sub:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    mov r11, r1
; CHECK-NEXT:    mov r1, r2
; CHECK-NEXT:    add r1, r11
; CHECK-NEXT:    cmp r1, r3
; CHECK-NEXT:    bcc .LBB0_2
; CHECK-NEXT:  // %bb.1:
; CHECK-NEXT:    sub r1, r4
; CHECK-NEXT:  .LBB0_2:
; CHECK-NEXT:    jmp lr
  %p = add i32 %pos, %inc
  %c = icmp uge i32 %p, %lim
  %s = select i1 %c, i32 %k, i32 0
  %r = sub i32 %p, %s
  ret i32 %r
}

