; RUN: llc -mtriple=penumbra-unknown-none -O2 < %s | FileCheck %s

; A signed remainder by a power of two is X - ((X sdiv 2^k) << k), with the
; divide expanded to shifts and an add, so no DIV reaches the divmul unit.
; The rewrite multiplies the quotient back by shifting, which is exact
; whenever the divisor's bit pattern is 1 << k -- INT_MIN included -- and
; wrong for a negated power of two, whose fused divide/remainder must keep
; the hardware divide.

define i32 @srem_4(i32 %x) {
; CHECK-LABEL: srem_4:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    mov r2, r1
; CHECK-NEXT:    sar r2, 31
; CHECK-NEXT:    shr r2, 30
; CHECK-NEXT:    add r2, r1
; CHECK-NEXT:    sar r2, 2
; CHECK-NEXT:    shl r2, 2
; CHECK-NEXT:    sub r1, r2
; CHECK-NEXT:    jmp lr
  %r = srem i32 %x, 4
  ret i32 %r
}

define i32 @srem_int_min(i32 %x) {
; CHECK-LABEL: srem_int_min:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    mov r2, r1
; CHECK-NEXT:    sar r2, 31
; CHECK-NEXT:    shr r2, 1
; CHECK-NEXT:    add r2, r1
; CHECK-NEXT:    sar r2, 31
; CHECK-NEXT:    mov r3, zero
; CHECK-NEXT:    sub r3, r2
; CHECK-NEXT:    shl r3, 31
; CHECK-NEXT:    sub r1, r3
; CHECK-NEXT:    jmp lr
  %r = srem i32 %x, -2147483648
  ret i32 %r
}

; div_rem_to_divrem fuses the pair into G_SDIVREM whenever the divide is
; visited first; the remainder must still come from the shared quotient.
define i32 @sdivrem_4(i32 %x, ptr %q) {
; CHECK-LABEL: sdivrem_4:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    mov r3, r1
; CHECK-NEXT:    sar r3, 31
; CHECK-NEXT:    shr r3, 30
; CHECK-NEXT:    add r3, r1
; CHECK-NEXT:    sar r3, 2
; CHECK-NEXT:    mov r4, r3
; CHECK-NEXT:    shl r4, 2
; CHECK-NEXT:    sub r1, r4
; CHECK-NEXT:    stw r3, [r2 + 0]
; CHECK-NEXT:    jmp lr
  %d = sdiv i32 %x, 4
  store i32 %d, ptr %q
  %r = srem i32 %x, 4
  ret i32 %r
}

