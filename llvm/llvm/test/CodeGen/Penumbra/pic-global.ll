; PIC-NEXT:  // %bb.1:
; PIC-NEXT:    mov r1, r15
; PIC-NEXT:    lli r2, %got_pcrel_lo16(myvar+4)
; PIC-NEXT:    lui r2, %got_pcrel_hi16(myvar+8)
; PIC-NEXT:    add r1, r2
