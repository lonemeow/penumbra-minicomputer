; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=penumbra-unknown-none -O2 < %s | FileCheck %s

; GlobalISel has no pointer subtract, so C's `p - n` reaches the backend as
; a pointer plus `0 - n`, scaled by the element size.  The post-legalizer
; combiner rewrites it as a subtract of the positive offset, where the
; negation would otherwise cost a zero copy, a subtract and an add.

define ptr @bytes(ptr %p, i32 %n) {
; CHECK-LABEL: bytes:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    sub r1, r2
; CHECK-NEXT:    jmp lr
  %neg = sub i32 0, %n
  %r = getelementptr inbounds i8, ptr %p, i32 %neg
  ret ptr %r
}

; A power-of-two element size scales the negation by a shift.
define ptr @words(ptr %p, i32 %n) {
; CHECK-LABEL: words:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    shl r2, 2
; CHECK-NEXT:    sub r1, r2
; CHECK-NEXT:    jmp lr
  %neg = sub i32 0, %n
  %r = getelementptr inbounds i32, ptr %p, i32 %neg
  ret ptr %r
}

; Any other element size scales it by a multiply, which the constant-multiply
; rule leaves for the subtract rather than decomposing around the negation.
%rec = type { i32, i32, i32 }
define ptr @records(ptr %p, i32 %n) {
; CHECK-LABEL: records:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    mov r3, r2
; CHECK-NEXT:    shl r3, 1
; CHECK-NEXT:    add r3, r2
; CHECK-NEXT:    shl r3, 2
; CHECK-NEXT:    sub r1, r3
; CHECK-NEXT:    jmp lr
  %neg = sub i32 0, %n
  %r = getelementptr inbounds %rec, ptr %p, i32 %neg
  ret ptr %r
}

; The protocol-input shape: `m->m_data -= off; m->m_len += off`.
define void @adjust(ptr %m, i32 %off) {
; CHECK-LABEL: adjust:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    ldw r3, [r1 + 0]
; CHECK-NEXT:    sub r3, r2
; CHECK-NEXT:    stw r3, [r1 + 0]
; CHECK-NEXT:    ldw r3, [r1 + 4]
; CHECK-NEXT:    add r3, r2
; CHECK-NEXT:    stw r3, [r1 + 4]
; CHECK-NEXT:    jmp lr
  %data = load ptr, ptr %m
  %neg = sub i32 0, %off
  %d = getelementptr inbounds i8, ptr %data, i32 %neg
  store ptr %d, ptr %m
  %lenp = getelementptr inbounds i8, ptr %m, i32 4
  %len = load i32, ptr %lenp
  %l = add i32 %len, %off
  store i32 %l, ptr %lenp
  ret void
}

; A negation that is also stored stays for the store; the pointer still
; subtracts.
define ptr @negation_kept(ptr %p, i32 %n, ptr %out) {
; CHECK-LABEL: negation_kept:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    mov r4, zero
; CHECK-NEXT:    sub r4, r2
; CHECK-NEXT:    stw r4, [r3 + 0]
; CHECK-NEXT:    sub r1, r2
; CHECK-NEXT:    jmp lr
  %neg = sub i32 0, %n
  store i32 %neg, ptr %out
  %r = getelementptr inbounds i8, ptr %p, i32 %neg
  ret ptr %r
}

; A scaled negation with another use is left alone: the rewrite would compute
; the scaling twice.
define ptr @scaled_kept(ptr %p, i32 %n, ptr %out) {
; CHECK-LABEL: scaled_kept:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    mov r4, zero
; CHECK-NEXT:    sub r4, r2
; CHECK-NEXT:    shl r4, 2
; CHECK-NEXT:    stw r4, [r3 + 0]
; CHECK-NEXT:    add r1, r4
; CHECK-NEXT:    jmp lr
  %neg = sub i32 0, %n
  %off = shl i32 %neg, 2
  store i32 %off, ptr %out
  %r = getelementptr inbounds i8, ptr %p, i32 %off
  ret ptr %r
}

; A scaled negation computed outside a loop stays there: rebuilding the
; scaling at the pointer add would repeat it on every iteration.
define ptr @loop_stride_shift(ptr %p, i32 %n, i32 %count) {
; CHECK-LABEL: loop_stride_shift:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  // %bb.0: // %entry
; CHECK-NEXT:    mov r4, zero
; CHECK-NEXT:    sub r4, r2
; CHECK-NEXT:    shl r4, 2
; CHECK-NEXT:  .LBB6_1: // %loop
; CHECK-NEXT:    // =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    add r1, r4
; CHECK-NEXT:    sub r3, 1
; CHECK-NEXT:    bne .LBB6_1
; CHECK-NEXT:  // %bb.2: // %exit
; CHECK-NEXT:    jmp lr
entry:
  %neg = sub i32 0, %n
  %off = shl i32 %neg, 2
  br label %loop
loop:
  %q = phi ptr [ %p, %entry ], [ %q.next, %loop ]
  %i = phi i32 [ %count, %entry ], [ %i.next, %loop ]
  %q.next = getelementptr inbounds i8, ptr %q, i32 %off
  %i.next = sub i32 %i, 1
  %done = icmp eq i32 %i.next, 0
  br i1 %done, label %exit, label %loop
exit:
  ret ptr %q.next
}

; Likewise for a multiply, which then still decomposes outside the loop.
define ptr @loop_stride_mul(ptr %p, i32 %n, i32 %count) {
; CHECK-LABEL: loop_stride_mul:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  // %bb.0: // %entry
; CHECK-NEXT:    mov r4, zero
; CHECK-NEXT:    sub r4, r2
; CHECK-NEXT:    mov r2, r4
; CHECK-NEXT:    shl r2, 1
; CHECK-NEXT:    add r2, r4
; CHECK-NEXT:    shl r2, 2
; CHECK-NEXT:  .LBB7_1: // %loop
; CHECK-NEXT:    // =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    add r1, r2
; CHECK-NEXT:    sub r3, 1
; CHECK-NEXT:    bne .LBB7_1
; CHECK-NEXT:  // %bb.2: // %exit
; CHECK-NEXT:    jmp lr
entry:
  %neg = sub i32 0, %n
  %off = mul i32 %neg, 12
  br label %loop
loop:
  %q = phi ptr [ %p, %entry ], [ %q.next, %loop ]
  %i = phi i32 [ %count, %entry ], [ %i.next, %loop ]
  %q.next = getelementptr inbounds i8, ptr %q, i32 %off
  %i.next = sub i32 %i, 1
  %done = icmp eq i32 %i.next, 0
  br i1 %done, label %exit, label %loop
exit:
  ret ptr %q.next
}
