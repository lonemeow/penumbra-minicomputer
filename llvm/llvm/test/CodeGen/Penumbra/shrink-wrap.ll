; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; Shrink-wrapping moves the prologue and epilogue off paths that never use the
; frame.  A restore point need not be a return block, so the epilogue goes
; where the callee-saved reloads are, and a block is refused as a save or
; restore point when adjusting SP there would clobber something still read:
; the flags a branch is about to test, or R11 in a frame too large for the
; immediate form.

; RUN: llc -mtriple=penumbra -global-isel -O2 -verify-machineinstrs < %s \
; RUN:   | FileCheck %s

declare i32 @g(i32)
declare i32 @h()
declare void @use(ptr)

; The restore point falls through into the shared return block, which has no
; terminator of its own: SP is released after the reloads.  The early path
; returns %a, already in place; a constant there would sink onto its own
; edge and the lone return block would be tail-duplicated away.
define i32 @fallthrough_restore(i32 %a) {
; CHECK-LABEL: fallthrough_restore:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    cmp r1, 0
; CHECK-NEXT:    beq .LBB0_2
; CHECK-NEXT:  // %bb.1: // %body
; CHECK-NEXT:    sub sp, 8
; CHECK-NEXT:    stw r5, [sp + 4] // 4-byte Folded Spill
; CHECK-NEXT:    stw lr, [sp + 0] // 4-byte Folded Spill
; CHECK-NEXT:    bl g
; CHECK-NEXT:    mov r5, r1
; CHECK-NEXT:    bl h
; CHECK-NEXT:    add r1, r5
; CHECK-NEXT:    ldw lr, [sp + 0] // 4-byte Folded Reload
; CHECK-NEXT:    ldw r5, [sp + 4] // 4-byte Folded Reload
; CHECK-NEXT:    add sp, 8
; CHECK-NEXT:  .LBB0_2: // %join
; CHECK-NEXT:    jmp lr
  %c = icmp eq i32 %a, 0
  br i1 %c, label %join, label %body
body:
  %r = call i32 @g(i32 %a)
  %r2 = call i32 @h()
  %s = add i32 %r, %r2
  br label %join
join:
  %v = phi i32 [ %a, %0 ], [ %s, %body ]
  ret i32 %v
}

; The only candidate restore point ends in a branch on the compare of the two
; call results, which releasing SP would clobber: the frame stays in the entry
; block.
define i32 @flags_live_at_restore(i32 %a) {
; CHECK-LABEL: flags_live_at_restore:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    sub sp, 8
; CHECK-NEXT:    cmp r1, 0
; CHECK-NEXT:    stw r5, [sp + 4] // 4-byte Folded Spill
; CHECK-NEXT:    stw lr, [sp + 0] // 4-byte Folded Spill
; CHECK-NEXT:    beq .LBB1_1
; CHECK-NEXT:  // %bb.3: // %body
; CHECK-NEXT:    bl g
; CHECK-NEXT:    mov r5, r1
; CHECK-NEXT:    bl h
; CHECK-NEXT:    cmp r5, r1
; CHECK-NEXT:    bge .LBB1_5
; CHECK-NEXT:  // %bb.4: // %ret1
; CHECK-NEXT:    lli r1, 1
; CHECK-NEXT:    b .LBB1_2
; CHECK-NEXT:  .LBB1_1: // %early
; CHECK-NEXT:    llis r1, -1
; CHECK-NEXT:    b .LBB1_2
; CHECK-NEXT:  .LBB1_5: // %ret2
; CHECK-NEXT:    lli r1, 2
; CHECK-NEXT:  .LBB1_2: // %early
; CHECK-NEXT:    ldw lr, [sp + 0] // 4-byte Folded Reload
; CHECK-NEXT:    ldw r5, [sp + 4] // 4-byte Folded Reload
; CHECK-NEXT:    add sp, 8
; CHECK-NEXT:    jmp lr
  %c = icmp eq i32 %a, 0
  br i1 %c, label %early, label %body
early:
  ret i32 -1
body:
  %r = call i32 @g(i32 %a)
  %r2 = call i32 @h()
  %lt = icmp slt i32 %r, %r2
  br i1 %lt, label %ret1, label %ret2
ret1:
  ret i32 1
ret2:
  ret i32 2
}

; R11 carries a / b past the early exit, and the frame is adjusted through R11:
; the frame stays in the entry block.  A divide stays where it is written,
; since a zero divisor traps; a multiply would sink into the block that uses it.
define void @large_frame_r11_live(i32 %a, i32 %b, i32 %c, i32 %d) {
; CHECK-LABEL: large_frame_r11_live:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    lli r11, 4472
; CHECK-NEXT:    lui r11, 1
; CHECK-NEXT:    sub sp, r11
; CHECK-NEXT:    lli r11, 4468
; CHECK-NEXT:    lui r11, 1
; CHECK-NEXT:    add r11, sp
; CHECK-NEXT:    stw lr, [r11 + 0] // 4-byte Folded Spill
; CHECK-NEXT:    mov r11, r1
; CHECK-NEXT:    divu r11, r2
; CHECK-NEXT:    cmp r4, 0
; CHECK-NEXT:    beq .LBB2_2
; CHECK-NEXT:  // %bb.1: // %body
; CHECK-NEXT:    add r1, r2
; CHECK-NEXT:    add r1, r3
; CHECK-NEXT:    add r1, r4
; CHECK-NEXT:    add r1, r11
; CHECK-NEXT:    mov r2, sp
; CHECK-NEXT:    add r2, 4
; CHECK-NEXT:    add r1, r2
; CHECK-NEXT:    lli r3, 1
; CHECK-NEXT:    stb r3, [r1 + 0]
; CHECK-NEXT:    mov r1, r2
; CHECK-NEXT:    bl use
; CHECK-NEXT:  .LBB2_2: // %early
; CHECK-NEXT:    lli r1, 4468
; CHECK-NEXT:    lui r1, 1
; CHECK-NEXT:    add r1, sp
; CHECK-NEXT:    ldw lr, [r1 + 0] // 4-byte Folded Reload
; CHECK-NEXT:    lli r11, 4472
; CHECK-NEXT:    lui r11, 1
; CHECK-NEXT:    add sp, r11
; CHECK-NEXT:    jmp lr
  %buf = alloca [70000 x i8]
  %x = udiv i32 %a, %b
  %z = icmp eq i32 %d, 0
  br i1 %z, label %early, label %body
early:
  ret void
body:
  %s1 = add i32 %a, %b
  %s2 = add i32 %s1, %c
  %s3 = add i32 %s2, %d
  %s4 = add i32 %s3, %x
  %p = getelementptr [70000 x i8], ptr %buf, i32 0, i32 %s4
  store i8 1, ptr %p
  call void @use(ptr %buf)
  ret void
}

; Nothing is live in R11 at the save point, so the large frame shrink-wraps.
define i32 @large_frame_r11_dead(i32 %a) {
; CHECK-LABEL: large_frame_r11_dead:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    cmp r1, 0
; CHECK-NEXT:    beq .LBB3_1
; CHECK-NEXT:  // %bb.2: // %body
; CHECK-NEXT:    lli r11, 4472
; CHECK-NEXT:    lui r11, 1
; CHECK-NEXT:    sub sp, r11
; CHECK-NEXT:    lli r1, 4468
; CHECK-NEXT:    lui r1, 1
; CHECK-NEXT:    add r1, sp
; CHECK-NEXT:    stw lr, [r1 + 0] // 4-byte Folded Spill
; CHECK-NEXT:    mov r1, sp
; CHECK-NEXT:    add r1, 4
; CHECK-NEXT:    bl use
; CHECK-NEXT:    lli r2, 4468
; CHECK-NEXT:    lui r2, 1
; CHECK-NEXT:    add r2, sp
; CHECK-NEXT:    ldw lr, [r2 + 0] // 4-byte Folded Reload
; CHECK-NEXT:    lli r11, 4472
; CHECK-NEXT:    lui r11, 1
; CHECK-NEXT:    lli r1, 1
; CHECK-NEXT:    add sp, r11
; CHECK-NEXT:    jmp lr
; CHECK-NEXT:  .LBB3_1: // %early
; CHECK-NEXT:    mov r1, zero
; CHECK-NEXT:    jmp lr
  %buf = alloca [70000 x i8]
  %z = icmp eq i32 %a, 0
  br i1 %z, label %early, label %body
early:
  ret i32 0
body:
  call void @use(ptr %buf)
  ret i32 1
}
