; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=penumbra -global-isel -O2 -verify-machineinstrs < %s \
; RUN:   | FileCheck %s

; ALU instructions and constant loads have no side effects, so the machine
; passes may move them: MachineSink puts a value computed for one arm of a
; branch into that arm, and MachineLICM lifts a loop-invariant constant out
; of the loop.

; The subtract is needed only on the wrap path, so it runs only there.
define i32 @sink_into_arm(i32 %pos, i32 %inc, i32 %lim, i32 %k) {
; CHECK-LABEL: sink_into_arm:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    mov r11, r1
; CHECK-NEXT:    mov r1, r2
; CHECK-NEXT:    add r1, r11
; CHECK-NEXT:    cmp r1, r3
; CHECK-NEXT:    bcc .LBB0_2
; CHECK-NEXT:  // %bb.1:
; CHECK-NEXT:    sub r1, r4
; CHECK-NEXT:  .LBB0_2:
; CHECK-NEXT:    jmp lr
  %p = add i32 %pos, %inc
  %c = icmp ult i32 %p, %lim
  %t = sub i32 %p, %k
  %r = select i1 %c, i32 %p, i32 %t
  ret i32 %r
}

; -32768 needs an LLIS; it is loaded once, before the loop.
define void @hoist_constant(ptr %p, i32 %n) {
; CHECK-LABEL: hoist_constant:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  // %bb.0: // %entry
; CHECK-NEXT:    llis r3, -32768
; CHECK-NEXT:    b .LBB1_1
; CHECK-NEXT:  .LBB1_3: // %loop
; CHECK-NEXT:    // in Loop: Header=BB1_1 Depth=1
; CHECK-NEXT:    stw r4, [r1 + 0]
; CHECK-NEXT:    add r1, 4
; CHECK-NEXT:    sub r2, 1
; CHECK-NEXT:    beq .LBB1_4
; CHECK-NEXT:  .LBB1_1: // %loop
; CHECK-NEXT:    // =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    ldw r4, [r1 + 0]
; CHECK-NEXT:    cmp r4, r3
; CHECK-NEXT:    bgt .LBB1_3
; CHECK-NEXT:  // %bb.2: // %loop
; CHECK-NEXT:    // in Loop: Header=BB1_1 Depth=1
; CHECK-NEXT:    mov r4, r3
; CHECK-NEXT:    b .LBB1_3
; CHECK-NEXT:  .LBB1_4: // %exit
; CHECK-NEXT:    jmp lr
entry:
  br label %loop
loop:
  %i = phi i32 [ 0, %entry ], [ %i1, %loop ]
  %a = getelementptr i32, ptr %p, i32 %i
  %x = load i32, ptr %a
  %lt = icmp slt i32 %x, -32768
  %y = select i1 %lt, i32 -32768, i32 %x
  store i32 %y, ptr %a
  %i1 = add i32 %i, 1
  %d = icmp eq i32 %i1, %n
  br i1 %d, label %exit, label %loop
exit:
  ret void
}
