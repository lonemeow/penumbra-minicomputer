define i32 @load_word(ptr %p) {
; CHECK-LABEL: load_word:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    ldw r1, [r1 + 0]
; CHECK-NEXT:    jmp r13
  %v = load i32, ptr %p
  ret i32 %v
}

