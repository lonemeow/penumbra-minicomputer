# RUN: split-file %s %t
# RUN: llc -mtriple=penumbra -run-pass=instruction-select %t/live-in.mir -o - \
# RUN:   | FileCheck %s --check-prefix=LIVE-IN
# RUN: not --crash llc -mtriple=penumbra -run-pass=instruction-select \
# RUN:   %t/unset.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=UNSET

# A block's own readers decide whether its flag definitions are dead, which
# holds because selection keeps each flag value within one block.  A value that
# does cross is named in the reading block's live-ins and keeps its producer
# live; a block that reads flags it neither sets nor names stops compilation
# rather than have its producer marked dead.

# LIVE-IN-LABEL: name: live_in
# LIVE-IN: CMP $r1, $r2, implicit-def $sr
# LIVE-IN: ADDi {{.*}}, 1, implicit-def dead $sr

# UNSET: LLVM ERROR: flags live into a block without SR as a live-in

#--- live-in.mir
--- |
  define void @live_in() { ret void }
...
---
name:            live_in
legalized:       true
regBankSelected: true
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1
    liveins: $r1, $r2

    CMP $r1, $r2, implicit-def $sr
    B %bb.1

  bb.1:
    successors: %bb.2, %bb.3
    liveins: $r1, $sr

    BEQ %bb.3, implicit $sr

  bb.2:
    liveins: $r1

    $r1 = ADDi $r1, 1, implicit-def $sr

  bb.3:
    liveins: $r1

    RET implicit $r1
...

#--- unset.mir
--- |
  define void @unset() { ret void }
...
---
name:            unset
legalized:       true
regBankSelected: true
tracksRegLiveness: false
body:             |
  bb.0:
    successors: %bb.1
    liveins: $r1, $r2

    CMP $r1, $r2, implicit-def $sr
    B %bb.1

  bb.1:
    successors: %bb.2, %bb.3
    liveins: $r1

    BEQ %bb.3, implicit $sr

  bb.2:
    liveins: $r1

    $r1 = ADDi $r1, 1, implicit-def $sr

  bb.3:
    liveins: $r1

    RET implicit $r1
...
