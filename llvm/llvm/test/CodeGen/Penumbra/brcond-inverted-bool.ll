; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=penumbra -global-isel -verify-machineinstrs -O2 < %s \
; RUN:   | FileCheck %s

; A branch whose true edge is the layout successor reaches selection on
; `XOR %c, 1`, masked to its low bit.  A compare absorbs the inversion into its
; predicate; any other boolean is tested directly with the branch sense
; flipped, instead of materialising the inverted value.

declare i1 @pred()
declare void @work()

define void @call_result() {
; CHECK-LABEL: call_result:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  // %bb.0: // %entry
; CHECK-NEXT:    sub sp, 4
; CHECK-NEXT:    stw lr, [sp + 0] // 4-byte Folded Spill
; CHECK-NEXT:    bl pred
; CHECK-NEXT:    test r1, 1
; CHECK-NEXT:    beq .LBB0_2
; CHECK-NEXT:  // %bb.1: // %body
; CHECK-NEXT:    bl work
; CHECK-NEXT:  .LBB0_2: // %done
; CHECK-NEXT:    ldw lr, [sp + 0] // 4-byte Folded Reload
; CHECK-NEXT:    add sp, 4
; CHECK-NEXT:    jmp lr
entry:
  %c = call i1 @pred()
  br i1 %c, label %body, label %done

body:
  call void @work()
  br label %done

done:
  ret void
}

define void @loaded_bool(ptr %p) {
; CHECK-LABEL: loaded_bool:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  // %bb.0: // %entry
; CHECK-NEXT:    ldb r1, [r1 + 0]
; CHECK-NEXT:    test r1, 1
; CHECK-NEXT:    beq .LBB1_2
; CHECK-NEXT:  // %bb.1: // %body
; CHECK-NEXT:    sub sp, 4
; CHECK-NEXT:    stw lr, [sp + 0] // 4-byte Folded Spill
; CHECK-NEXT:    bl work
; CHECK-NEXT:    ldw lr, [sp + 0] // 4-byte Folded Reload
; CHECK-NEXT:    add sp, 4
; CHECK-NEXT:  .LBB1_2: // %done
; CHECK-NEXT:    jmp lr
entry:
  %b = load i8, ptr %p
  %c = trunc i8 %b to i1
  br i1 %c, label %body, label %done

body:
  call void @work()
  br label %done

done:
  ret void
}

; The inverted value has a second user, so it is materialised for that user
; and the branch tests it as it stands.
define i32 @inverted_value_used(i1 %c) {
; CHECK-LABEL: inverted_value_used:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  // %bb.0: // %entry
; CHECK-NEXT:    sub sp, 8
; CHECK-NEXT:    lli r2, 1
; CHECK-NEXT:    xor r2, r1
; CHECK-NEXT:    stw r5, [sp + 4] // 4-byte Folded Spill
; CHECK-NEXT:    mov r5, r2
; CHECK-NEXT:    and r5, 1
; CHECK-NEXT:    test r2, 1
; CHECK-NEXT:    stw lr, [sp + 0] // 4-byte Folded Spill
; CHECK-NEXT:    bne .LBB2_2
; CHECK-NEXT:  // %bb.1: // %body
; CHECK-NEXT:    bl work
; CHECK-NEXT:  .LBB2_2: // %done
; CHECK-NEXT:    mov r1, r5
; CHECK-NEXT:    ldw lr, [sp + 0] // 4-byte Folded Reload
; CHECK-NEXT:    ldw r5, [sp + 4] // 4-byte Folded Reload
; CHECK-NEXT:    add sp, 8
; CHECK-NEXT:    jmp lr
entry:
  %n = xor i1 %c, true
  %z = zext i1 %n to i32
  br i1 %n, label %done, label %body

body:
  call void @work()
  br label %done

done:
  ret i32 %z
}
