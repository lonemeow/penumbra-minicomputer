; The producer widens: a caller its arguments, a callee its result, and a
; caller trusts a widened result.

declare void @take_char(i8 signext)
declare void @take_uchar(i8 zeroext)
declare signext i8 @get_char()

define void @pass_char(i32 %v) {
; CHECK-LABEL: pass_char:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    sub sp, 4
; CHECK-NEXT:    stw lr, [sp + 0] // 4-byte Folded Spill
; CHECK-NEXT:    shl r1, 24
; CHECK-NEXT:    sar r1, 24
; CHECK-NEXT:    bl take_char
; CHECK-NEXT:    ldw lr, [sp + 0] // 4-byte Folded Reload
; CHECK-NEXT:    add sp, 4
; CHECK-NEXT:    jmp lr
  %c = trunc i32 %v to i8
  call void @take_char(i8 signext %c)
  ret void
}

define void @pass_uchar(i32 %v) {
; CHECK-LABEL: pass_uchar:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    sub sp, 4
; CHECK-NEXT:    stw lr, [sp + 0] // 4-byte Folded Spill
; CHECK-NEXT:    and r1, 255
; CHECK-NEXT:    bl take_uchar
; CHECK-NEXT:    ldw lr, [sp + 0] // 4-byte Folded Reload
; CHECK-NEXT:    add sp, 4
; CHECK-NEXT:    jmp lr
  %c = trunc i32 %v to i8
  call void @take_uchar(i8 zeroext %c)
  ret void
}

define signext i8 @return_char(i32 %v) {
; CHECK-LABEL: return_char:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    shl r1, 24
; CHECK-NEXT:    sar r1, 24
; CHECK-NEXT:    jmp lr
  %c = trunc i32 %v to i8
  ret i8 %c
}

define zeroext i16 @return_ushort(i32 %v) {
; CHECK-LABEL: return_ushort:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    and r1, 65535
; CHECK-NEXT:    jmp lr
  %c = trunc i32 %v to i16
  ret i16 %c
}

define i32 @use_char_result() {
; CHECK-LABEL: use_char_result:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    sub sp, 4
; CHECK-NEXT:    stw lr, [sp + 0] // 4-byte Folded Spill
; CHECK-NEXT:    bl get_char
; CHECK-NEXT:    ldw lr, [sp + 0] // 4-byte Folded Reload
; CHECK-NEXT:    add sp, 4
; CHECK-NEXT:    jmp lr
  %c = call signext i8 @get_char()
  %r = sext i8 %c to i32
  ret i32 %r
}
