; A value narrower than 32 bits travels widened per its signedness
; (doc/system/abi.md, "Argument Passing"): the producer widens it and a
; consumer told so by `signext`/`zeroext` relies on that.  Without the
; attribute nothing is promised, and the value is extended in its
; register: SHL + SAR to sign-extend, AND to zero-extend.

; No promise: the callee extends.

define i32 @sext_i8(i8 %x) {
; CHECK-LABEL: sext_i8:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    shl r1, 24
; CHECK-NEXT:    sar r1, 24
; CHECK-NEXT:    jmp lr
  %r = sext i8 %x to i32
  ret i32 %r
}

define i32 @sext_i16(i16 %x) {
; CHECK-LABEL: sext_i16:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    shl r1, 16
; CHECK-NEXT:    sar r1, 16
; CHECK-NEXT:    jmp lr
  %r = sext i16 %x to i32
  ret i32 %r
}

define i32 @zext_i8(i8 %x) {
; CHECK-LABEL: zext_i8:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    and r1, 255
; CHECK-NEXT:    jmp lr
  %r = zext i8 %x to i32
  ret i32 %r
}

define i32 @zext_i16(i16 %x) {
; CHECK-LABEL: zext_i16:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    and r1, 65535
; CHECK-NEXT:    jmp lr
  %r = zext i16 %x to i32
  ret i32 %r
}

define i32 @zext_i1(i1 %b) {
; CHECK-LABEL: zext_i1:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    and r1, 1
; CHECK-NEXT:    jmp lr
  %r = zext i1 %b to i32
  ret i32 %r
}

