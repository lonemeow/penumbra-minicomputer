; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=penumbra -global-isel -verify-machineinstrs -O2 < %s \
; RUN:   | FileCheck %s

; Compare and branch forms that avoid materializing a constant or copying an
; operand: a bit test selects TEST, which sets the AND's flags without writing
; its result, and a constant that does not fit a compare's uimm16 immediate
; moves the predicate to an adjacent constant that does.

declare void @f(i32)

; The flags word is tested again after the first test, so an AND would need a
; copy of it.
define void @bit_test_live(i32 %flags) {
; CHECK-LABEL: bit_test_live:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  // %bb.0: // %entry
; CHECK-NEXT:    sub sp, 8
; CHECK-NEXT:    test r1, 4
; CHECK-NEXT:    stw r5, [sp + 4] // 4-byte Folded Spill
; CHECK-NEXT:    stw lr, [sp + 0] // 4-byte Folded Spill
; CHECK-NEXT:    beq .LBB0_2
; CHECK-NEXT:  // %bb.1: // %t1
; CHECK-NEXT:    mov r5, r1
; CHECK-NEXT:    lli r1, 1
; CHECK-NEXT:    bl f
; CHECK-NEXT:    mov r1, r5
; CHECK-NEXT:  .LBB0_2: // %n1
; CHECK-NEXT:    test r1, 8
; CHECK-NEXT:    beq .LBB0_4
; CHECK-NEXT:  // %bb.3: // %t2
; CHECK-NEXT:    bl f
; CHECK-NEXT:  .LBB0_4: // %done
; CHECK-NEXT:    ldw lr, [sp + 0] // 4-byte Folded Reload
; CHECK-NEXT:    ldw r5, [sp + 4] // 4-byte Folded Reload
; CHECK-NEXT:    add sp, 8
; CHECK-NEXT:    jmp lr
entry:
  %a = and i32 %flags, 4
  %ca = icmp ne i32 %a, 0
  br i1 %ca, label %t1, label %n1
t1:
  call void @f(i32 1)
  br label %n1
n1:
  %b = and i32 %flags, 8
  %cb = icmp eq i32 %b, 0
  br i1 %cb, label %done, label %t2
t2:
  call void @f(i32 %flags)
  br label %done
done:
  ret void
}

; A mask wider than the immediate tests against its register.
define void @bit_test_wide_mask(i32 %flags) {
; CHECK-LABEL: bit_test_wide_mask:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  // %bb.0: // %entry
; CHECK-NEXT:    lli r2, 0
; CHECK-NEXT:    lui r2, 1
; CHECK-NEXT:    test r1, r2
; CHECK-NEXT:    beq .LBB1_2
; CHECK-NEXT:  // %bb.1: // %t1
; CHECK-NEXT:    sub sp, 4
; CHECK-NEXT:    stw lr, [sp + 0] // 4-byte Folded Spill
; CHECK-NEXT:    bl f
; CHECK-NEXT:    ldw lr, [sp + 0] // 4-byte Folded Reload
; CHECK-NEXT:    add sp, 4
; CHECK-NEXT:  .LBB1_2: // %done
; CHECK-NEXT:    jmp lr
entry:
  %a = and i32 %flags, 65536
  %ca = icmp ne i32 %a, 0
  br i1 %ca, label %t1, label %done
t1:
  call void @f(i32 %flags)
  br label %done
done:
  ret void
}

; The masked value has another user, so the AND is built and compared.
define i32 @bit_test_and_used(i32 %flags) {
; CHECK-LABEL: bit_test_and_used:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  // %bb.0: // %entry
; CHECK-NEXT:    and r1, 4
; CHECK-NEXT:    beq .LBB2_2
; CHECK-NEXT:  // %bb.1: // %t1
; CHECK-NEXT:    sub sp, 8
; CHECK-NEXT:    stw r5, [sp + 4] // 4-byte Folded Spill
; CHECK-NEXT:    stw lr, [sp + 0] // 4-byte Folded Spill
; CHECK-NEXT:    mov r5, r1
; CHECK-NEXT:    bl f
; CHECK-NEXT:    mov r1, r5
; CHECK-NEXT:    ldw lr, [sp + 0] // 4-byte Folded Reload
; CHECK-NEXT:    ldw r5, [sp + 4] // 4-byte Folded Reload
; CHECK-NEXT:    add sp, 8
; CHECK-NEXT:  .LBB2_2: // %done
; CHECK-NEXT:    jmp lr
entry:
  %a = and i32 %flags, 4
  %ca = icmp ne i32 %a, 0
  br i1 %ca, label %t1, label %done
t1:
  call void @f(i32 %a)
  br label %done
done:
  ret i32 %a
}

; `x >= 0` arrives as `x > -1` for a select and `x <= -1` for a branch.
define i32 @nonneg(i32 %x, i32 %y) {
; CHECK-LABEL: nonneg:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  // %bb.0: // %entry
; CHECK-NEXT:    cmp r1, 0
; CHECK-NEXT:    blt .LBB3_4
; CHECK-NEXT:  // %bb.1: // %pos
; CHECK-NEXT:    cmp r2, 0
; CHECK-NEXT:    bge .LBB3_3
; CHECK-NEXT:  // %bb.2: // %pos
; CHECK-NEXT:    mov r1, r2
; CHECK-NEXT:  .LBB3_3: // %pos
; CHECK-NEXT:    jmp lr
; CHECK-NEXT:  .LBB3_4: // %neg
; CHECK-NEXT:    mov r1, zero
; CHECK-NEXT:    jmp lr
entry:
  %c = icmp sgt i32 %x, -1
  br i1 %c, label %pos, label %neg
pos:
  %s = icmp sgt i32 %y, -1
  %r = select i1 %s, i32 %x, i32 %y
  ret i32 %r
neg:
  ret i32 0
}

define i32 @signed_below_64k(i32 %x) {
; CHECK-LABEL: signed_below_64k:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  // %bb.0: // %entry
; CHECK-NEXT:    cmp r1, 65535
; CHECK-NEXT:    bgt .LBB4_2
; CHECK-NEXT:  // %bb.1: // %small
; CHECK-NEXT:    lli r1, 1
; CHECK-NEXT:    jmp lr
; CHECK-NEXT:  .LBB4_2: // %big
; CHECK-NEXT:    lli r1, 2
; CHECK-NEXT:    jmp lr
entry:
  %c = icmp slt i32 %x, 65536
  br i1 %c, label %small, label %big
small:
  ret i32 1
big:
  ret i32 2
}

define i32 @unsigned_at_least_64k(i32 %x) {
; CHECK-LABEL: unsigned_at_least_64k:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  // %bb.0: // %entry
; CHECK-NEXT:    cmp r1, 65535
; CHECK-NEXT:    bls .LBB5_1
; CHECK-NEXT:  // %bb.2: // %big
; CHECK-NEXT:    lli r1, 2
; CHECK-NEXT:    jmp lr
; CHECK-NEXT:  .LBB5_1: // %small
; CHECK-NEXT:    lli r1, 1
; CHECK-NEXT:    jmp lr
entry:
  %c = icmp uge i32 %x, 65536
  br i1 %c, label %big, label %small
small:
  ret i32 1
big:
  ret i32 2
}

; Stepping down from the top of the unsigned range gives a constant that still
; does not fit, so the compare keeps its register.
define i32 @unsigned_below_max(i32 %x) {
; CHECK-LABEL: unsigned_below_max:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  // %bb.0: // %entry
; CHECK-NEXT:    llis r2, -1
; CHECK-NEXT:    cmp r1, r2
; CHECK-NEXT:    bcs .LBB6_2
; CHECK-NEXT:  // %bb.1: // %small
; CHECK-NEXT:    lli r1, 1
; CHECK-NEXT:    jmp lr
; CHECK-NEXT:  .LBB6_2: // %big
; CHECK-NEXT:    lli r1, 2
; CHECK-NEXT:    jmp lr
entry:
  %c = icmp ult i32 %x, -1
  br i1 %c, label %small, label %big
small:
  ret i32 1
big:
  ret i32 2
}
