; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=penumbra -global-isel -verify-machineinstrs -O2 < %s \
; RUN:   | FileCheck %s

; An add followed by a check of whether it wrapped stays an add and a compare
; through CodeGenPrepare rather than becoming uadd.with.overflow.  The compare
; selects next to its branch, and compare elimination reuses the add's flags
; where the branch reads only Z.  A wider add keeps the overflow form, whose
; carry is the last ADC's.

declare void @work(i32)

; The exit test LSR leaves on a `do { } while (count--)` loop: the
; up-counter's increment reaching zero.
define void @countdown_exit(i32 %start) {
; CHECK-LABEL: countdown_exit:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  // %bb.0: // %entry
; CHECK-NEXT:    sub sp, 8
; CHECK-NEXT:    stw r5, [sp + 4] // 4-byte Folded Spill
; CHECK-NEXT:    stw lr, [sp + 0] // 4-byte Folded Spill
; CHECK-NEXT:    mov r5, r1
; CHECK-NEXT:  .LBB0_1: // %loop
; CHECK-NEXT:    // =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    mov r1, r5
; CHECK-NEXT:    bl work
; CHECK-NEXT:    add r5, 1
; CHECK-NEXT:    bne .LBB0_1
; CHECK-NEXT:  // %bb.2: // %exit
; CHECK-NEXT:    ldw lr, [sp + 0] // 4-byte Folded Reload
; CHECK-NEXT:    ldw r5, [sp + 4] // 4-byte Folded Reload
; CHECK-NEXT:    add sp, 8
; CHECK-NEXT:    jmp lr
entry:
  br label %loop

loop:
  %iv = phi i32 [ %start, %entry ], [ %iv.next, %loop ]
  call void @work(i32 %iv)
  %iv.next = add i32 %iv, 1
  %done = icmp eq i32 %iv.next, 0
  br i1 %done, label %exit, label %loop

exit:
  ret void
}

; A general wrap check compares the sum against an addend; compare elimination
; branches on the add's carry instead.
define i32 @wrap_check(i32 %a, i32 %b) {
; CHECK-LABEL: wrap_check:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  // %bb.0: // %entry
; CHECK-NEXT:    add r2, r1
; CHECK-NEXT:    bcc .LBB1_1
; CHECK-NEXT:  // %bb.2: // %overflow
; CHECK-NEXT:    llis r1, -1
; CHECK-NEXT:    jmp lr
; CHECK-NEXT:  .LBB1_1: // %ok
; CHECK-NEXT:    mov r1, r2
; CHECK-NEXT:    jmp lr
entry:
  %sum = add i32 %a, %b
  %wrapped = icmp ult i32 %sum, %b
  br i1 %wrapped, label %overflow, label %ok

ok:
  ret i32 %sum

overflow:
  ret i32 -1
}

; bintime_addx: a 64-bit accumulator bumps a second word when it wraps.  As
; an overflow op the wrap is the ADC's carry; as a compare it would expand to
; a two-word unsigned compare.
define void @wide_wrap_carry(ptr %bt, i64 %x) {
; CHECK-LABEL: wide_wrap_carry:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  // %bb.0: // %entry
; CHECK-NEXT:    ldw r4, [r1 + 0]
; CHECK-NEXT:    ldw r11, [r1 + 4]
; CHECK-NEXT:    add r4, r2
; CHECK-NEXT:    adc r11, r3
; CHECK-NEXT:    mov r2, zero
; CHECK-NEXT:    adc r2, zero
; CHECK-NEXT:    stw r4, [r1 + 0]
; CHECK-NEXT:    stw r11, [r1 + 4]
; CHECK-NEXT:    test r2, 1
; CHECK-NEXT:    beq .LBB2_2
; CHECK-NEXT:  // %bb.1: // %bump
; CHECK-NEXT:    ldw r2, [r1 + 8]
; CHECK-NEXT:    ldw r3, [r1 + 12]
; CHECK-NEXT:    add r2, 1
; CHECK-NEXT:    adc r3, zero
; CHECK-NEXT:    stw r2, [r1 + 8]
; CHECK-NEXT:    stw r3, [r1 + 12]
; CHECK-NEXT:  .LBB2_2: // %done
; CHECK-NEXT:    jmp lr
entry:
  %u = load i64, ptr %bt
  %frac = add i64 %u, %x
  store i64 %frac, ptr %bt
  %wrapped = icmp ugt i64 %u, %frac
  br i1 %wrapped, label %bump, label %done

bump:
  %sec.p = getelementptr i8, ptr %bt, i32 8
  %sec = load i64, ptr %sec.p
  %sec.1 = add i64 %sec, 1
  store i64 %sec.1, ptr %sec.p
  br label %done

done:
  ret void
}
