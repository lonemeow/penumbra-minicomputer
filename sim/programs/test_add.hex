// Penumbra CPU integration test program
//
// 0x00: LLI R1, #5         Phase 1: basic ALU
// 0x04: LLI R5, #0xFF      Also serves as IRQ handler (vector 1 = addr 0x04)
// 0x08: LLI R2, #3
// 0x0C: ADD R1, R2          R1 = 8
// 0x10: LLI R3, #0
// 0x14: EI                  Enable interrupts (ei_shadow blocks next instr)
// 0x18: LLI R4, #0x42       Executes under ei_shadow
// 0x1C: LLI R6, #0xDD       First IRQ-eligible dispatch
// 0x20: LLI R7, #0xEE       Next instruction
//
// Encoding notes:
//   Format R: {00, op[4:0], Rd[3:0], Rs[3:0], ...}
//   EI = op 0x19 = 25 -> 0x19 << 25 = 0x32000000
//   Format L: {01, op[2:0], Rd[3:0], spare[6:0], imm16[15:0]}
//   LLI Rd, #imm = {01, 000, Rd, 0000000, imm16}
40800005
428000FF
41000003
00240000
41800000
32000000
42000042
430000DD
438000EE
