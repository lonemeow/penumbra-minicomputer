// Test: Interrupt entry
// Memory layout:
//   0x00: LLI R1, #0xAA   (main code — will be interrupted)
//   0x04: LLI R5, #0xFF   (IRQ handler at vector 1 = addr 0x04)
//   0x08: LLI R2, #0xBB   (main continues if no IRQ, or after RTI)
//   0x0C: LLI R3, #0xCC
//
// Test scenario: assert i_irq after R1 is loaded.
// Expected: R5=0xFF (handler ran), R1=0xAA (pre-interrupt)
// The handler at 0x04 runs instead of instruction at 0x08.
408000AA
428000FF
410000BB
418000CC
