# Penumbra Microcode Source
#
# Dispatch addresses (computed by fetch unit from IR bits):
#   Format R: op[4]=0 → 0x00 + 2*op[3:0];  op[4]=1 → 0x40 + 2*op[3:0]
#     ALU     (op 0–11):  0x00–0x16   (single-cycle)
#     divmul  (op 16–19): 0x40–0x46   (multi-cycle MUL/MULU/DIV/DIVU peer)
#     SYS     (op 23–31): 0x4E–0x5E   (9 system instructions)
#     Reserved: op 12–15 + op 20–22 — illegal sentinel
#   Format L: {01, op[3:0], 0}            → entries 0x20–0x3E (×2 spacing)
#   Format M: {10, L, sz[1:0], SE, 00}    → entries 0x80–0xBF (×4 spacing)
#   Format B: {11, 0000000}               → entry 0x60
#   Interrupt/fault entry:                → entry 0x70 (hardwired)
#
# Format R opcode map:
#   ALU:    0=ADD 1=SUB 2=AND 3=OR 4=XOR 5=SHL 6=SHR 7=SAR
#           8=MOV 9=NOT 10=ADC 11=SBC
#   divmul: 16=MUL 17=MULU 18=DIV 19=DIVU
#   SYS:    23=WRSYS 24=RDSYS 25=SYSCALL 26=BREAK 27=ERET
#           28=EI 29=DI 30=WRSPR 31=RDSPR
#   Reserved (illegal): 12–15 (future single-cycle), 20–22 (future peer-unit)
#
# Format L opcode map:
#   0=LLI 1=LLIS 2=LUI 3=INC 4=DEC 5=CMPI 6=ANDI 7=TESTI
#   8=SHLi 9=SHRi 10=SARi 11=JMP 12=JALR 13–15=(reserved)
#
# Register address encoding:
#   IR_RD = format-dependent Rd, IR_RS = format-dependent Rs/Rb,
#   IR_RDH = the Rdh field (IR[15:12], MUL/DIV third operand),
#   R3–R15 = literal register number
#
# Assembler defaults (uasm.py applies these when not specified):
#   pc=NEXT, branch=FETCH
# All other fields default to 0 (hardware zero):
#   a_src=REG, alu=ADD, bmux=REG, wb_src=RBUS, all enables off.

# ═══════════════════════════════════════════════════════════════
# Format R — ALU operations (op 0–11)
# Dispatch: {00, 0, op[3:0], 0}
# ═══════════════════════════════════════════════════════════════

# ── ADD (op=0, dispatch=0x00) ─────────────────────────────────
.org 0x00
add:
  reg_a=IR_RD reg_b=IR_RS reg_w=IR_RD w_en=1 alu=ADD bmux=REG wb_src=RBUS w_flags=1

# ── SUB (op=1, dispatch=0x02) ─────────────────────────────────
.org 0x02
sub:
  reg_a=IR_RD reg_b=IR_RS reg_w=IR_RD w_en=1 alu=SUB bmux=REG wb_src=RBUS w_flags=1

# ── AND (op=2, dispatch=0x04) ─────────────────────────────────
.org 0x04
and:
  reg_a=IR_RD reg_b=IR_RS reg_w=IR_RD w_en=1 alu=AND bmux=REG wb_src=RBUS w_flags=1

# ── OR (op=3, dispatch=0x06) ──────────────────────────────────
.org 0x06
or:
  reg_a=IR_RD reg_b=IR_RS reg_w=IR_RD w_en=1 alu=OR bmux=REG wb_src=RBUS w_flags=1

# ── XOR (op=4, dispatch=0x08) ─────────────────────────────────
.org 0x08
xor:
  reg_a=IR_RD reg_b=IR_RS reg_w=IR_RD w_en=1 alu=XOR bmux=REG wb_src=RBUS w_flags=1

# ── SHL (op=5, dispatch=0x0A) ─────────────────────────────────
.org 0x0A
shl:
  reg_a=IR_RD reg_b=IR_RS reg_w=IR_RD w_en=1 alu=SHL bmux=REG wb_src=RBUS w_flags=1

# ── SHR (op=6, dispatch=0x0C) ─────────────────────────────────
.org 0x0C
shr:
  reg_a=IR_RD reg_b=IR_RS reg_w=IR_RD w_en=1 alu=SHR bmux=REG wb_src=RBUS w_flags=1

# ── SAR (op=7, dispatch=0x0E) ─────────────────────────────────
.org 0x0E
sar:
  reg_a=IR_RD reg_b=IR_RS reg_w=IR_RD w_en=1 alu=SAR bmux=REG wb_src=RBUS w_flags=1

# ── MOV (op=8, dispatch=0x10) ─────────────────────────────────
# Rd = Rs (pass A-bus through ALU)
.org 0x10
mov:
  reg_a=IR_RS reg_w=IR_RD w_en=1 alu=PASS_A wb_src=RBUS

# ── NOT (op=9, dispatch=0x12) ─────────────────────────────────
# Rd = ~Rs
.org 0x12
not:
  reg_b=IR_RS reg_w=IR_RD w_en=1 alu=NOT wb_src=RBUS w_flags=1

# ── ADC (op=10, dispatch=0x14) ────────────────────────────────
# Rd = Rd + Rs + Carry (add with carry from SR.C)
.org 0x14
adc:
  reg_a=IR_RD reg_b=IR_RS reg_w=IR_RD w_en=1 alu=ADC bmux=REG wb_src=RBUS w_flags=1

# ── SBC (op=11, dispatch=0x16) ────────────────────────────────
# Rd = Rd - Rs - ~Carry (subtract with borrow, ARM convention)
.org 0x16
sbc:
  reg_a=IR_RD reg_b=IR_RS reg_w=IR_RD w_en=1 alu=SBC bmux=REG wb_src=RBUS w_flags=1

# ═══════════════════════════════════════════════════════════════
# Format L — Immediate operations (0x20–0x3E, ×2 spacing)
# Dispatch: {01, op[3:0], 0}
# ═══════════════════════════════════════════════════════════════

# ── LLI Rd, #imm16 (op=0000, dispatch=0x20) ──────────────────
# Rd = zero_extend(imm16)
.org 0x20
lli:
  reg_w=IR_RD w_en=1 alu=PASS_B bmux=IMM wb_src=RBUS imm_mode=ZERO_EXT

# ── LLIS Rd, #imm16 (op=0001, dispatch=0x22) ─────────────────
# Rd = sign_extend(imm16)
.org 0x22
llis:
  reg_w=IR_RD w_en=1 alu=PASS_B bmux=IMM wb_src=RBUS imm_mode=SIGN_EXT

# ── LUI Rd, #imm16 (op=0010, dispatch=0x24) ──────────────────
# Rd = Rd | (imm16 << 16)
.org 0x24
lui:
  reg_a=IR_RD reg_w=IR_RD w_en=1 alu=OR bmux=IMM wb_src=RBUS imm_mode=SHIFT_L16

# ── ADD Rd, #imm16 (op=0011, dispatch=0x26) ──────────────────
# Rd = Rd + zero_extend(imm16)   [assembler: ADD Rd, #imm → Format L]
.org 0x26
inc:
  reg_a=IR_RD reg_w=IR_RD w_en=1 alu=ADD bmux=IMM wb_src=RBUS imm_mode=ZERO_EXT w_flags=1

# ── SUB Rd, #imm16 (op=0100, dispatch=0x28) ──────────────────
# Rd = Rd - zero_extend(imm16)   [assembler: SUB Rd, #imm → Format L]
.org 0x28
dec:
  reg_a=IR_RD reg_w=IR_RD w_en=1 alu=SUB bmux=IMM wb_src=RBUS imm_mode=ZERO_EXT w_flags=1

# ── CMP Rd, #imm16 (op=0101, dispatch=0x2A) ──────────────────
# Flags = Rd - zero_extend(imm16), Rd not written   [assembler: CMP Rd, #imm → Format L]
.org 0x2A
cmpi:
  reg_a=IR_RD alu=SUB bmux=IMM wb_src=RBUS imm_mode=ZERO_EXT w_flags=1

# ── AND Rd, #imm16 (op=0110, dispatch=0x2C) ──────────────────
# Rd = Rd & zero_extend(imm16)   [assembler: AND Rd, #imm → Format L]
.org 0x2C
andi:
  reg_a=IR_RD reg_w=IR_RD w_en=1 alu=AND bmux=IMM wb_src=RBUS imm_mode=ZERO_EXT w_flags=1

# ── TEST Rd, #imm16 (op=0111, dispatch=0x2E) ─────────────────
# Flags = Rd & zero_extend(imm16), Rd not written   [assembler: TEST Rd, #imm → Format L]
.org 0x2E
testi:
  reg_a=IR_RD alu=AND bmux=IMM wb_src=RBUS imm_mode=ZERO_EXT w_flags=1

# ── SHL Rd, #imm5 (op=1000, dispatch=0x30) ───────────────────
# Rd = Rd << imm[4:0]   [assembler: SHL Rd, #imm → Format L]
.org 0x30
shli:
  reg_a=IR_RD reg_w=IR_RD w_en=1 alu=SHL bmux=IMM wb_src=RBUS imm_mode=ZERO_EXT w_flags=1

# ── SHR Rd, #imm5 (op=1001, dispatch=0x32) ───────────────────
# Rd = Rd >> imm[4:0] (logical)   [assembler: SHR Rd, #imm → Format L]
.org 0x32
shri:
  reg_a=IR_RD reg_w=IR_RD w_en=1 alu=SHR bmux=IMM wb_src=RBUS imm_mode=ZERO_EXT w_flags=1

# ── SAR Rd, #imm5 (op=1010, dispatch=0x34) ───────────────────
# Rd = Rd >> imm[4:0] (arithmetic)   [assembler: SAR Rd, #imm → Format L]
.org 0x34
sari:
  reg_a=IR_RD reg_w=IR_RD w_en=1 alu=SAR bmux=IMM wb_src=RBUS imm_mode=ZERO_EXT w_flags=1

# ── JMP Rs (op=11, dispatch=0x36) ────────────────────────────
# PC = Rd field (register indirect jump; RET = JMP R13)
# Note: Format L uses Rd field for the register, not Rs.
.org 0x36
jmp:
  reg_a=IR_RD pc=ABUS

# ── JALR Rs (op=12, dispatch=0x38) ───────────────────────────
# Jump and link register: R13 = PC+4, PC = (old Rd).
#
# Rd is *captured before* R13 is written, so `jalr r13` (the
# canonical indirect-call pattern: ldw r13, [ptr]; jalr r13) jumps
# to the original target rather than self-clobbering to PC+4.
#
# Step 0: latch old Rd into MDR (via mdr_load_a from A-bus).
# Step 1: write R13 = PC+4 *and* set PC = MDR in the same µ-op —
# the link writeback and the PC source are independent fields,
# so they coexist cleanly.
.org 0x38
jalr:
  reg_a=IR_RD mdr_load_a=1 pc=HOLD branch=SEQ
  reg_a=R15 bmux=CONST4 alu=ADD reg_w=R13 w_en=1 wb_src=RBUS pc=MDR

# ═══════════════════════════════════════════════════════════════
# Format R — hardware MUL/DIV (op 16–19) via the divmul peer unit
#
# Three micro-ops. The ×2 dispatch spacing gives only 2 slots, so op-1 SKIPs
# to a shared high-half tail:
#   op-0: read Rd→A, Rs→B, set the divmul op + pulse divmul_start, then STALL.
#         divmul asserts busy combinationally on the start edge and holds it
#         through the ~34-cycle iteration; the STALL releases when it falls.
#   op-1: write the low half (wb_src=DML_LO: quotient / product low) → Rd,
#         latching Z/N, then SKIP to the shared high-half tail.
#   tail: write the high half (wb_src=DML_HI: remainder / product high) → Rdh.
#
# alu=MUL/DIV are the signed ops; MULU/DIVU are unsigned. The alu= on op-0
# only selects the divmul operation and starts it; the writebacks pick the
# result explicitly via wb_src, so a divmul result never touches the R-bus.
# ═══════════════════════════════════════════════════════════════

# ── MUL (op=16, dispatch=0x40) ────────────────────────────────
.org 0x40
mul:
  reg_a=IR_RD reg_b=IR_RS alu=MUL divmul_start=1 bmux=REG pc=HOLD branch=STALL
  reg_w=IR_RD w_en=1 wb_src=DML_LO w_flags=1 pc=HOLD branch=SKIP fwd_offset=7

# ── MULU (op=17, dispatch=0x42) ───────────────────────────────
.org 0x42
mulu:
  reg_a=IR_RD reg_b=IR_RS alu=MULU divmul_start=1 bmux=REG pc=HOLD branch=STALL
  reg_w=IR_RD w_en=1 wb_src=DML_LO w_flags=1 pc=HOLD branch=SKIP fwd_offset=5

# ── DIV (op=18, dispatch=0x44) ────────────────────────────────
.org 0x44
div:
  reg_a=IR_RD reg_b=IR_RS alu=DIV divmul_start=1 bmux=REG pc=HOLD branch=STALL
  reg_w=IR_RD w_en=1 wb_src=DML_LO w_flags=1 pc=HOLD branch=SKIP fwd_offset=3

# ── DIVU (op=19, dispatch=0x46) ───────────────────────────────
.org 0x46
divu:
  reg_a=IR_RD reg_b=IR_RS alu=DIVU divmul_start=1 bmux=REG pc=HOLD branch=STALL
  reg_w=IR_RD w_en=1 wb_src=DML_LO w_flags=1 pc=HOLD branch=SKIP fwd_offset=1

# Shared high-half writeback: Rdh ← divmul_hi (product high / remainder).
# Reached only via the SKIP above. 0x49 is op20's second slot, never a
# dispatch target (op20 stays an illegal sentinel at 0x48). For the 2-operand
# form (Rdh=R0) the write is dropped, discarding the high half.
.org 0x49
divmul_hi_wb:
  reg_w=IR_RDH w_en=1 wb_src=DML_HI

# ═══════════════════════════════════════════════════════════════
# Format R — System operations (op 23–31)
# Dispatch: {00, 1, op[3:0], 0}  (op[4]=1 → +0x40 offset)
# ═══════════════════════════════════════════════════════════════

# ── WRSYS Rd, #dev, #reg (op=23, dispatch=0x4E) ──────────────
# Write register Rd to system device register. A-bus carries Rd value,
# sys_cycle + sys_we tell the target device to latch it.
# Privileged — priv=1 checked by sequencer on first micro-op.
.org 0x4E
wrsys:
  priv=1 reg_a=IR_RD sys_op=SYS_WRITE

# ── RDSYS Rd, #dev, #reg (op=24, dispatch=0x50) ──────────────
# Read system register into Rd. Two micro-ops:
#   Step 0: sys_cycle=1 puts device data on sysreg bus → cpu_top
#           muxes it onto mem_rdata → MDR captures it.
#   Step 1: writeback MDR to Rd.
# Privileged.
.org 0x50
rdsys:
  priv=1 sys_op=SYS_READ mdr_load_mem=1 pc=HOLD branch=SEQ
  reg_w=IR_RD w_en=1 wb_src=MDR

# ── SYSCALL (op=25, dispatch=0x52) ────────────────────────────
# System call trap: intercepted at dispatch time by cpu_top.
# Triggers except_entry → VEC_SYSCALL exception (like BREAK).
# Unprivileged — works from user mode.
# This microcode entry is never reached — dispatch redirects to
# int_entry (0x70). Slot left empty intentionally.

# ── BREAK (op=26, dispatch=0x54) ──────────────────────────────
# Software breakpoint: intercepted at dispatch time by cpu_top.
# Triggers except_entry → VEC_BREAK exception (like IRQ/fault).
# This microcode entry is never reached — dispatch redirects to
# int_entry (0x70). Slot left empty intentionally.

# ── ERET (op=27, dispatch=0x56) ───────────────────────────────
# Exception return via EPC/ESR: restore ESR then EPC.
# Privileged — must be in supervisor mode.
# Step 0: ESR → ALU PASS_A → R-bus → w_bus → sr_load
#         (restores NZCV flags, S and I mode bits)
# Step 1: EPC → A-bus → PC (jumps back to interrupted instruction)
.org 0x56
rti:
  priv=1 a_src=ESR alu=PASS_A sr_load=1 pc=HOLD branch=SEQ
  a_src=EPC pc=ABUS

# ── EI (op=28, dispatch=0x58) ────────────────────────────────
# Enable interrupts: SR.I = 1, delayed by one instruction (ei_shadow)
.org 0x58
ei:
  priv=1 ei_set=1

# ── DI (op=29, dispatch=0x5A) ────────────────────────────────
# Disable interrupts: SR.I = 0, immediate effect (privileged)
.org 0x5A
di:
  priv=1 di_set=1

# ── WRSPR {ESR|EPC|USP}, Rd (op=30, dispatch=0x5C) ────────────
# Write Rd to the SPR selected by IR[15:12]. Privileged.
# Rd → A-bus → ALU PASS_A → R-bus → target SPR.
# Hardware decode (spr_write = sys_we & !sys_cycle):
#   SPR 0 (ESR): esr_load from R-bus
#   SPR 1 (EPC): epc_load from R-bus
#   SPR 2 (USP): R14 cross_bank write from R-bus
.org 0x5C
wrspr:
  priv=1 reg_a=IR_RD alu=PASS_A sys_op=SPR_WRITE

# ── RDSPR Rd, {ESR|EPC|USP} (op=31, dispatch=0x5E) ────────────
# Read SPR selected by IR[15:12] into Rd. Privileged.
# a_src=SPR: hardware decodes IR[15:12] to select source:
#   SPR 0 (ESR): A-bus ← ESR latch
#   SPR 1 (EPC): A-bus ← EPC latch
#   SPR 2 (USP): A-bus ← R14 cross_bank read
# Source → ALU PASS_A → R-bus → Rd
.org 0x5E
rdspr:
  priv=1 a_src=SPR alu=PASS_A reg_w=IR_RD w_en=1 wb_src=RBUS

# ═══════════════════════════════════════════════════════════════
# Format B — Branches (0x60)
# ═══════════════════════════════════════════════════════════════

.org 0x60
branch:
  pc=OFFSET branch=BRT

# ── BL — Branch and Link (cond=1111, dispatch=0x62) ──────
# Two micro-ops:
#   Step 0: Save return address (PC+4) to R13 (link register)
#   Step 1: Branch to PC+offset (unconditionally)
.org 0x62
bl:
  reg_a=R15 bmux=CONST4 alu=ADD reg_w=R13 w_en=1 wb_src=RBUS pc=HOLD branch=SEQ
  pc=OFFSET

# ═══════════════════════════════════════════════════════════════
# Exception/interrupt entry (0x70)
# Hardware has already saved EPC, ESR, set S=1, I=0
# via except_entry pulse. This micro-routine reads the handler
# address from the vector table (MIPS/68k-style: table contains
# addresses, not instructions) and jumps there.
#
# Vector table: 16 words at physical 0x00, MMU bypassed.
# Software writes handler addresses via STW at boot time.
# ═══════════════════════════════════════════════════════════════

.org 0x70
int_entry:
  a_src=VECTOR alu=PASS_A mar_load=1 pc=HOLD branch=SEQ
  mem_read=1 mdr_load_mem=1 pc=HOLD branch=STALL
  pc=MDR

# ═══════════════════════════════════════════════════════════════
# Format M — Memory load/store (0x80–0xBF, ×4 spacing)
# Dispatch: {10, L, sz[1:0], SE, 00}
#
# Memory access pattern (latency-agnostic via STALL):
#   Micro-op 0: MAR ← Rb + sext(offset)              [address compute]
#   Load:  STALL with mem_read + mdr_load_mem → Rd ← MDR     (3 micro-ops)
#   Store: MDR ← Rd → STALL mem_write → advance PC          (4 micro-ops)
# ═══════════════════════════════════════════════════════════════

# ── STB Rd, [Rb + #offset] (L=0, sz=00, SE=0, dispatch=0x80) ─
.org 0x80
stb:
  reg_a=IR_RS bmux=IMM imm_mode=SIGN_EXT alu=ADD mar_load=1 pc=HOLD branch=SEQ
  reg_a=IR_RD mdr_load_a=1 pc=HOLD branch=SEQ
  mem_write=1 mem_size=BYTE pc=HOLD branch=STALL
  pc=NEXT

# ── STH Rd, [Rb + #offset] (L=0, sz=01, SE=0, dispatch=0x88) ─
.org 0x88
sth:
  reg_a=IR_RS bmux=IMM imm_mode=SIGN_EXT alu=ADD mar_load=1 pc=HOLD branch=SEQ
  reg_a=IR_RD mdr_load_a=1 pc=HOLD branch=SEQ
  mem_write=1 mem_size=HALF pc=HOLD branch=STALL
  pc=NEXT

# ── STW Rd, [Rb + #offset] (L=0, sz=10, SE=0, dispatch=0x90) ─
# Step 0: compute address, load MAR
# Step 1: load store data (Rd) into MDR via A-bus
# Step 2: initiate write, stall until accepted (MMU/bus may add latency)
# Step 3: advance PC
.org 0x90
stw:
  reg_a=IR_RS bmux=IMM imm_mode=SIGN_EXT alu=ADD mar_load=1 pc=HOLD branch=SEQ
  reg_a=IR_RD mdr_load_a=1 pc=HOLD branch=SEQ
  mem_write=1 mem_size=WORD pc=HOLD branch=STALL
  pc=NEXT

# ── LDB Rd, [Rb + #offset] (L=1, sz=00, SE=0, dispatch=0xA0) ─
# Byte load, zero-extended. byte_ext in datapath handles extraction.
.org 0xA0
ldb:
  reg_a=IR_RS bmux=IMM imm_mode=SIGN_EXT alu=ADD mar_load=1 pc=HOLD branch=SEQ
  mem_read=1 mem_size=BYTE mdr_load_mem=1 pc=HOLD branch=STALL
  reg_w=IR_RD w_en=1 wb_src=MDR mem_size=BYTE

# ── LDBS Rd, [Rb + #offset] (L=1, sz=00, SE=1, dispatch=0xA4) ─
# Byte load, sign-extended. byte_ext in datapath handles extraction.
.org 0xA4
ldbs:
  reg_a=IR_RS bmux=IMM imm_mode=SIGN_EXT alu=ADD mar_load=1 pc=HOLD branch=SEQ
  mem_read=1 mem_size=BYTE mdr_load_mem=1 pc=HOLD branch=STALL
  reg_w=IR_RD w_en=1 wb_src=MDR mem_size=BYTE sign_ext=1

# ── LDH Rd, [Rb + #offset] (L=1, sz=01, SE=0, dispatch=0xA8) ─
# Halfword load, zero-extended. byte_ext in datapath handles extraction.
.org 0xA8
ldh:
  reg_a=IR_RS bmux=IMM imm_mode=SIGN_EXT alu=ADD mar_load=1 pc=HOLD branch=SEQ
  mem_read=1 mem_size=HALF mdr_load_mem=1 pc=HOLD branch=STALL
  reg_w=IR_RD w_en=1 wb_src=MDR mem_size=HALF

# ── LDHS Rd, [Rb + #offset] (L=1, sz=01, SE=1, dispatch=0xAC) ─
# Halfword load, sign-extended. byte_ext in datapath handles extraction.
.org 0xAC
ldhs:
  reg_a=IR_RS bmux=IMM imm_mode=SIGN_EXT alu=ADD mar_load=1 pc=HOLD branch=SEQ
  mem_read=1 mem_size=HALF mdr_load_mem=1 pc=HOLD branch=STALL
  reg_w=IR_RD w_en=1 wb_src=MDR mem_size=HALF sign_ext=1

# ── LDW Rd, [Rb + #offset] (L=1, sz=10, SE=0, dispatch=0xB0) ─
# Word load. byte_ext passes through unchanged (size=WORD).
.org 0xB0
ldw:
  reg_a=IR_RS bmux=IMM imm_mode=SIGN_EXT alu=ADD mar_load=1 pc=HOLD branch=SEQ
  mem_read=1 mem_size=WORD mdr_load_mem=1 pc=HOLD branch=STALL
  reg_w=IR_RD w_en=1 wb_src=MDR
