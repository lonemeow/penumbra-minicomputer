# udev rules for the Penumbra FPGA boards. Install steps: DEVELOP.md,
# "Board USB devices".
#
# The programmer (openFPGALoader) runs in a container as the invoking
# user and reaches each board's FTDI chip through /dev/bus/usb.
SUBSYSTEM=="usb", ATTR{idVendor}=="0403", ATTR{idProduct}=="6010", MODE="0666", GROUP="plugdev"
SUBSYSTEM=="usb", ATTR{idVendor}=="0403", ATTR{idProduct}=="6015", MODE="0666", GROUP="plugdev"

# Each board's console gets a fixed name: a symlink to whichever ttyUSB
# node it enumerated as. The programmer never opens these.
SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6015", ATTRS{product}=="ULX3S*", SYMLINK+="ulx3s-console"

# The Nexys Video's UART port is a stock FT232R, which only its serial
# number tells apart from any other, so this line names one board. For
# another, read its serial with
#   udevadm info -a -n /dev/ttyUSBn | grep 'ATTRS{serial}'
SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6001", ATTRS{serial}=="AV0JXM31", SYMLINK+="nexysvideo-console"
