# The pinned openFPGALoader commit and the local image built from it,
# named once: the Makefile includes this file and the wrapper sources
# it, so it has to parse as both make and sh (plain VAR=value, ${}
# references). The commit is past v1.1.1 because that release rejects
# the SW_CRC key Vivado 2025.2 writes into .bit headers; a tagged
# release carrying the fix can replace it.
OFL_COMMIT=22c18f7d575c368c5e2aa9dd4eded4337a12529e
OFL_IMAGE=penumbra-openfpgaloader:${OFL_COMMIT}
