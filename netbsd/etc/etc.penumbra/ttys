#
#	$NetBSD$
#
# name	getty				type	status		comments

# Console pseudo-devices.  Both stay off: /dev/constty follows whichever
# tty is the kernel console, which is already given a getty by name
# below, and two gettys on one UART fight over its input.
console	"/usr/libexec/getty default"	vt100	off secure
constty	"/usr/libexec/getty default"	vt100	off secure

# Penumbra 16450 UART serial port
tty00	"/usr/libexec/getty default"	vt100	on secure

# wscons screens on the display adapter (keyboard via ukbd -> wskbd)
ttyE0	"/usr/libexec/getty default"	wsvt25	on secure
ttyE1	"/usr/libexec/getty default"	wsvt25	off secure
