# Penumbra boot loader — standalone build (no build.sh)
#
# Builds a PIE ELF (PENBOOT.ELF) that the ROM loads from FAT32.
# The CRT stub in crt0.s self-relocates before calling main().
#
# Usage:
#   make -f Makefile.standalone
#   make -f Makefile.standalone clean

MAKEFILE_DIR := $(dir $(realpath $(lastword $(MAKEFILE_LIST))))
ROOT      := $(realpath $(MAKEFILE_DIR)/../../../../../..)
SYSDIR    := $(ROOT)/netbsd/sys
ARCHDIR   := $(SYSDIR)/arch/penumbra
BOOTDIR   := $(ARCHDIR)/stand/boot
LIBSADIR  := $(ARCHDIR)/stand/libsa
BUILD     := $(ROOT)/build/bootloader

LLVM_PREFIX ?= $(ROOT)/build/llvm
CC       = $(LLVM_PREFIX)/bin/clang --target=penumbra-unknown-none
MC       = $(LLVM_PREFIX)/bin/llvm-mc --triple=penumbra-unknown-none --filetype=obj
LD       = $(LLVM_PREFIX)/bin/ld.lld
OBJCOPY  = $(LLVM_PREFIX)/bin/llvm-objcopy
READOBJ  = $(LLVM_PREFIX)/bin/llvm-readobj

CFLAGS   = -O0 -ffreestanding -fPIE -nostdinc -D_STANDALONE -D__NetBSD__ \
           -I$(SYSDIR) -MMD -MP

LDFLAGS  = --pie -T $(BOOTDIR)/boot.ld -e _start

# Sources
BOOT_C   = boot.c conf.c mulsi3.c
LIBSA_C  = sdblk.c cons.c
ASM      = crt0.S

# Objects
BOOT_OBJS  = $(BOOT_C:%.c=$(BUILD)/%.o)
LIBSA_OBJS = $(LIBSA_C:%.c=$(BUILD)/%.o)
ASM_OBJS   = $(ASM:%.S=$(BUILD)/%.o)
ALL_OBJS   = $(ASM_OBJS) $(BOOT_OBJS) $(LIBSA_OBJS)

TARGET     = $(BUILD)/PENBOOT.ELF

.PHONY: all clean machine-symlink

all: machine-symlink $(TARGET)
	@echo "Boot loader built: $(TARGET)"

machine-symlink:
	@ln -sfn arch/penumbra/include $(SYSDIR)/machine

$(TARGET): $(ALL_OBJS) | $(BUILD)
	$(LD) $(LDFLAGS) -o $@ $(ALL_OBJS)
	@$(READOBJ) -h -r --dynamic-table $@ 2>&1 | head -30

$(BUILD)/%.o: $(BOOTDIR)/%.c | $(BUILD)
	$(CC) $(CFLAGS) -c -o $@ $<

$(BUILD)/%.o: $(LIBSADIR)/%.c | $(BUILD)
	$(CC) $(CFLAGS) -c -o $@ $<

$(BUILD)/%.o: $(BOOTDIR)/%.S | $(BUILD)
	$(CC) $(CFLAGS) -c -o $@ $<

$(BUILD):
	@mkdir -p $@

clean:
	rm -rf $(BUILD)
	rm -f $(SYSDIR)/machine

-include $(ALL_OBJS:.o=.d)
