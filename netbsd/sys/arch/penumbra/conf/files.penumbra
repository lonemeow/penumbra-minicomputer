#	$NetBSD$
#
# Penumbra machine-dependent configuration info.
#

# maxpartitions must be the first item in files.${ARCH}
maxpartitions 8

maxusers 2 8 64

# PMAP options
defflag	opt_pmap.h			PMAP_STEAL_MEMORY

# Console glue
file	dev/cons.c

# Machine-dependent kernel code
file	arch/penumbra/penumbra/startup.c
file	arch/penumbra/penumbra/machdep.c
file	arch/penumbra/penumbra/mulsi3.c
file	arch/penumbra/penumbra/autoconf.c
file	arch/penumbra/penumbra/trap.c
file	arch/penumbra/penumbra/syscall.c
file	arch/penumbra/penumbra/pmap.c
file	arch/penumbra/penumbra/copy.S

# System bus
device	mainbus {}
attach	mainbus at root
file	arch/penumbra/penumbra/mainbus.c		mainbus

# CPU
device	cpu
attach	cpu at mainbus
file	arch/penumbra/penumbra/cpu.c			cpu

# Penumbra Bus bridge (enumerates bootinfo devices)
device	pbbus { }
attach	pbbus at mainbus
file	arch/penumbra/penumbra/pbbus.c			pbbus

# Console UART (MI com driver with pbbus attachment)
attach	com at pbbus with com_pbbus
file	arch/penumbra/penumbra/com_pbbus.c		com_pbbus

# SD card block device
device	psd: disk
attach	psd at pbbus
file	arch/penumbra/penumbra/psd.c			psd

# bus_space implementation
file	arch/penumbra/penumbra/bus_space.c

include	"arch/penumbra/conf/majors.penumbra"
