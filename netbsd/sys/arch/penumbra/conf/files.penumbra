#	$NetBSD$
#
# Penumbra machine-dependent configuration info.
#

# maxpartitions must be the first item in files.${ARCH}
maxpartitions 8

maxusers 2 8 64

# PMAP options
defflag	opt_pmap.h			PMAP_STEAL_MEMORY

# Console glue
file	dev/cons.c

# Machine-dependent kernel code
file	arch/penumbra/penumbra/startup.c
file	arch/penumbra/penumbra/machdep.c
file	arch/penumbra/penumbra/mulsi3.c
file	arch/penumbra/penumbra/autoconf.c
file	arch/penumbra/penumbra/trap.c
file	arch/penumbra/penumbra/intr.c
file	arch/penumbra/penumbra/syscall.c
file	arch/penumbra/penumbra/pmap.c
file	arch/penumbra/penumbra/copy.S
file	arch/penumbra/penumbra/cache_perfctrs.c
file	arch/penumbra/penumbra/cpu_perfctrs.c

# Kernel debugger (DDB) machine-dependent support
file	arch/penumbra/penumbra/db_machdep.c		ddb
file	arch/penumbra/penumbra/db_trace.c		ddb
file	arch/penumbra/penumbra/db_disasm.c		ddb

# System bus
device	mainbus {}
attach	mainbus at root
file	arch/penumbra/penumbra/mainbus.c		mainbus

# CPU
device	cpu
attach	cpu at mainbus
file	arch/penumbra/penumbra/cpu.c			cpu

# Penumbra Bus bridge (enumerates bootinfo devices)
device	pbbus { }
attach	pbbus at mainbus
file	arch/penumbra/penumbra/pbbus.c			pbbus

# Console UART (MI com driver with pbbus attachment)
attach	com at pbbus with com_pbbus
file	arch/penumbra/penumbra/com_pbbus.c		com_pbbus

# SD/MMC host controller: Penumbra SPI-mode MMC interface.
# The `sdmmcbus' interface attribute lets files.sdmmc's
# "attach sdmmc at sdmmcbus" pick pmci up as a host; sdmmc in
# turn attaches ld_sdmmc -> ld as the block device.
include "dev/sdmmc/files.sdmmc"
device	pmci: sdmmcbus
attach	pmci at pbbus
file	arch/penumbra/penumbra/pmci.c			pmci

# USB host controller (CLASS_USBHC transaction-level minimum)
include "dev/usb/files.usb"
device	pusbhc: usbus, usbroothub
attach	pusbhc at pbbus
file	arch/penumbra/penumbra/pusbhc.c			pusbhc

# bus_space implementation
file	arch/penumbra/penumbra/bus_space.c

# MI MBR-style disklabel reader — needed by ld_sdmmc and any other
# block-device driver that wants partition tables (readdisklabel /
# writedisklabel).  Pulled in by the `disk' attribute.
file	kern/subr_disk_mbr.c				disk

include	"arch/penumbra/conf/majors.penumbra"
