#	$NetBSD$
#
# MINIMAL -- bare-minimum Penumbra kernel config for initial build testing.
# Not expected to produce a bootable kernel yet.
#

include		"arch/penumbra/conf/std.penumbra"

maxusers	2

# Kernel options
options		DDB			# kernel debugger
options		DDB_HISTORY_SIZE=512
options		DIAGNOSTIC		# enable KASSERT checks
options		PMAP_STEAL_MEMORY	# early boot page allocation

# File systems (minimal set)
file-system	FFS			# Berkeley Fast File System
file-system	MSDOSFS			# MS-DOS FAT file system

# Networking (minimal)
options		INET			# IP

# System bus
mainbus0	at root
cpu0		at mainbus?
pbbus0		at mainbus?
com0		at pbbus?

# SD/MMC host (pmci) -> MI sdmmc -> ld block device.
pmci0		at pbbus?
sdmmc*		at pmci?

# USB host controller -> MI USB stack root
pusbhc0		at pbbus?
usb*		at pusbhc?
uhub*		at usb?
ld*		at sdmmc?

# Console
options		CONSDEV_OVERRIDE="\"uart\""

# Pseudo-devices
pseudo-device	loop			# loopback interface
pseudo-device	pty			# pseudo-terminals
pseudo-device	ksyms			# /dev/ksyms

config		netbsd root on ? type ?
