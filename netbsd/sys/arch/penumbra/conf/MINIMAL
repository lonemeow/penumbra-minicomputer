#	$NetBSD$
#
# MINIMAL -- the smallest bootable Penumbra kernel: serial console,
# SD block device, FFS root.  Documents the port's true floor and
# builds fast, which makes it the smoke-test config for MD changes.
# For a usable machine, build GENERIC (or GENERIC.DEBUG).
#

include		"arch/penumbra/conf/std.penumbra"

maxusers	2

# Kernel options
options		DDB			# kernel debugger
options		DDB_HISTORY_SIZE=512
options		DIAGNOSTIC		# enable KASSERT checks
options		PMAP_STEAL_MEMORY	# early boot page allocation

# File systems
file-system	FFS			# Berkeley Fast File System

# Networking (loop requires it)
options		INET			# IP

# System bus
mainbus0	at root
cpu0		at mainbus?
pbbus0		at mainbus?
com0		at pbbus?

# SD/MMC host (pmci) -> MI sdmmc -> ld block device.
pmci0		at pbbus?
sdmmc*		at pmci?
ld*		at sdmmc?

# Console
options		CONSDEV_OVERRIDE="\"uart\""

# Pseudo-devices
pseudo-device	loop			# loopback interface
pseudo-device	pty			# pseudo-terminals
pseudo-device	ksyms			# /dev/ksyms

config		netbsd root on ? type ?
