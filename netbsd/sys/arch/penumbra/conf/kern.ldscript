/* $NetBSD$ */

/* Linker script for NetBSD/penumbra kernels */
OUTPUT_FORMAT("elf32-penumbra")
OUTPUT_ARCH(penumbra)
ENTRY(_start)

_DYNAMIC_LINK = 0;

SECTIONS
{
  /* Read-only sections, merged into text segment.
     Kernel Makefile sets start address via -Ttext. */
  .text :
  {
    _ftext = . ;

    /*
     * Hot routines, first so their addresses are KERNEL_TEXT_BASE plus
     * a fixed offset: nothing precedes them, so no later code change
     * moves them across a page boundary into another TLB set.
     */
    _hot_text_start = . ;
    *memcpy.o(.text)
    *memset.o(.text)
    *memcmp.o(.text)
    *strlen.o(.text)
    *strcmp.o(.text)
    *strcpy.o(.text)
    *atomic_cas.o(.text)
    *lock_stubs.o(.text)
    _hot_text_end = . ;

    *(.text)
    *(.text.*)
    *(.gnu.warning)
  } =0

  /*
   * Copied to the vector page at boot, never executed here.  After
   * live text so its size cannot move it; page-aligned because the
   * kernel-text copy is mapped read-only by the page.
   */
  . = ALIGN(0x1000);
  .text.trappage : { *(.text.trappage) }

  _etext = .;
  PROVIDE (etext = .);

  .rodata : { *(.rodata) *(.rodata.*) }

  . = ALIGN(0x1000);
  .data :
  {
    _fdata = . ;
    *(.data)
    CONSTRUCTORS
    . = ALIGN(32);
    *(.data.cacheline_aligned)
    . = ALIGN(32);
    *(.data.read_mostly)
    . = ALIGN(32);
  }
  _edata = .;
  PROVIDE (edata = .);

  __bss_start = .;
  _fbss = .;
  .bss :
  {
    *(.bss)
    *(COMMON)
  }
  _end = . ;
  PROVIDE (end = .);

  /*
   * The TLB miss handler + scratch data is copied to the vector page
   * at offset 0x80.  It must fit within the remaining 4096 - 128 = 3968
   * bytes of the page.
   */
  ASSERT(_real_handlers_end - _real_miss_handler <= 4096 - 128,
         "TLB miss handler too large for vector page")
}
