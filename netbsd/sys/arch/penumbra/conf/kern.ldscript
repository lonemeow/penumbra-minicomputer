/* $NetBSD$ */

/* Linker script for NetBSD/penumbra kernels */
#include "assym.h"

OUTPUT_FORMAT("elf32-penumbra")
OUTPUT_ARCH(penumbra)
ENTRY(_start)

_DYNAMIC_LINK = 0;

SECTIONS
{
  /* Read-only sections, merged into text segment.
     Kernel Makefile sets start address via -Ttext. */
  .text :
  {
    _ftext = . ;
    *(.text)
    *(.text.*)
    *(.gnu.warning)
  } =0

  /*
   * Copied to the vector page at boot, never executed here, so its
   * size must not displace live code.  The name stays outside .text.*
   * or the wildcard above claims it first.
   */
  . = ALIGN(0x1000);
  .trappage : { *(.trappage) }

  _etext = .;
  PROVIDE (etext = .);

  .rodata : { *(.rodata) *(.rodata.*) }

  . = ALIGN(0x1000);
  .data :
  {
    _fdata = . ;

    /*
     * cpu_info_store has a page to itself, which a pinned TLB slot maps
     * (pmap_bootstrap), so the page never competes for a main-TLB way.
     *
     * Offset from the page start to reduce L1 D-cache conflicts; there are
     * many dynamically allocated structures that end up being page aligned,
     * offsetting to a cache line that doesn't alias with those in any likely
     * cache configuration is beneficial.
     */
    #define CPU_INFO_PAGE_OFFSET 128
    . += CPU_INFO_PAGE_OFFSET;
    *(.data.cpu_info)
    ASSERT(. - _fdata <= PAGE_SIZE, "cpu_info_store crosses its page");
    . = _fdata + PAGE_SIZE;

    *(.data)
    CONSTRUCTORS
    . = ALIGN(32);
    *(.data.cacheline_aligned)
    . = ALIGN(32);
    *(.data.read_mostly)
    . = ALIGN(32);
  }
  _edata = .;
  PROVIDE (edata = .);

  __bss_start = .;
  _fbss = .;
  .bss :
  {
    *(.bss)
    *(COMMON)
  }
  _end = . ;
  PROVIDE (end = .);

  /*
   * The TLB miss handler + scratch data is copied to the vector page
   * at offset 0x80.  It must fit within the remaining 4096 - 128 = 3968
   * bytes of the page.
   */
  ASSERT(_real_handlers_end - _real_miss_handler <= 4096 - 128,
         "TLB miss handler too large for vector page")

  /* A wildcard claiming the section first goes wrong silently. */
  ASSERT(_etext - _real_handlers_page_start <= 2 * PAGE_SIZE,
         "trap page must be linked after all live text")
}
