/* $NetBSD$ */

/* Linker script for NetBSD/penumbra kernels */
#include "assym.h"

/*
 * Tenants of the hot text page, in one list because it is expanded
 * twice: once to place them, once to assert each arrived.  A pattern
 * matching nothing is silent, so a mistyped name -- or one that is an
 * alias rather than the symbol a section is named for -- would
 * otherwise simply not happen.
 *
 * A() starts a routine on a cache line; P() packs one that fits
 * within a single line into the tail an aligned neighbour leaves.
 * Routines reached only from DIAGNOSTIC are listed unconditionally:
 * they exist in either kernel, so one built without it spends their
 * bytes and nothing else.
 */
#define HOT_STR_(x) #x
#define HOT_STR(x) HOT_STR_(x)

#define HOT_TEXT_TENANTS \
	A(splx) \
	A(spl0) \
	A(splvm) \
	A(splhigh) \
	A(splsoftserial) \
	A(rw_vector_enter) \
	A(rw_vector_tryenter) \
	A(rw_vector_exit) \
	A(getticks) \
	A(mutex_owned) \
	A(cpu_intr_p) \
	A(cpu_softintr_p) \
	A(kpreempt_disabled) \
	A(rw_lock_held) \
	A(cv_has_waiters) \
	A(radix_tree_empty_tree_p) \
	A(pool_redzone_check) \
	P(cpu_kpreempt_disabled) \
	P(_membar_sync)

OUTPUT_FORMAT("elf32-penumbra")
OUTPUT_ARCH(penumbra)
ENTRY(_start)

_DYNAMIC_LINK = 0;

SECTIONS
{
  /* Read-only sections, merged into text segment.
     Kernel Makefile sets start address via -Ttext. */
  .text :
  {
    _ftext = . ;

    /*
     * First in .text so no later code change moves a region across a
     * page boundary into another TLB set.  Deliberately not padded to
     * a page: the slot pins all of it, so whatever follows rides along.
     * ALIGN keeps a routine off a line it has no use for; object sizes
     * drift, so that cannot be left to luck.
     */
    _hot_text0_start = . ;

    /* Assembly objects carry a single .text, so pull them whole. */
    . = ALIGN(COHERENCY_UNIT); *memcpy.o(.text)
    . = ALIGN(COHERENCY_UNIT); *memset.o(.text)
    . = ALIGN(COHERENCY_UNIT); *memcmp.o(.text)
    . = ALIGN(COHERENCY_UNIT); *strlen.o(.text)
    . = ALIGN(COHERENCY_UNIT); *strcmp.o(.text)
    . = ALIGN(COHERENCY_UNIT); *strcpy.o(.text)
    . = ALIGN(COHERENCY_UNIT); *atomic_cas.o(.text)
    . = ALIGN(COHERENCY_UNIT); *lock_stubs.o(.text)

    /* C routines, whose objects hold far more than the page. */
#define A(sym) . = ALIGN(COHERENCY_UNIT); _hot_at_##sym = . ; \
	*(.text.sym) ; _hot_end_##sym = . ;
#define P(sym) _hot_at_##sym = . ; *(.text.sym) ; _hot_end_##sym = . ;
    HOT_TEXT_TENANTS
#undef A
#undef P

    _hot_text0_end = . ;

    *(.text)
    *(.text.*)
    *(.gnu.warning)
  } =0

  /*
   * Copied to the vector page at boot, never executed here, so its
   * size must not displace live code.  The name stays outside .text.*
   * or the wildcard above claims it first.
   */
  . = ALIGN(0x1000);
  .trappage : { *(.trappage) }

  _etext = .;
  PROVIDE (etext = .);

  .rodata : { *(.rodata) *(.rodata.*) }

  . = ALIGN(0x1000);
  .data :
  {
    _fdata = . ;

    /* Hot data, first in .data for the same reason. */
    _hot_data0_start = . ;
    *(.data.hot0)
    _hot_data0_end = . ;

    *(.data)
    CONSTRUCTORS
    . = ALIGN(32);
    *(.data.cacheline_aligned)
    . = ALIGN(32);
    *(.data.read_mostly)
    . = ALIGN(32);
  }
  _edata = .;
  PROVIDE (edata = .);

  __bss_start = .;
  _fbss = .;
  .bss :
  {
    *(.bss)
    *(COMMON)
  }
  _end = . ;
  PROVIDE (end = .);

  /*
   * The TLB miss handler + scratch data is copied to the vector page
   * at offset 0x80.  It must fit within the remaining 4096 - 128 = 3968
   * bytes of the page.
   */
  ASSERT(_real_handlers_end - _real_miss_handler <= 4096 - 128,
         "TLB miss handler too large for vector page")

  /* A wildcard claiming the section first goes wrong silently. */
  ASSERT(_etext - _real_handlers_page_start <= 2 * PAGE_SIZE,
         "trap page must be linked after all live text")

  /* For nm: what is left of each pinned page. */
  _hot_text0_free = PAGE_SIZE - (_hot_text0_end - _hot_text0_start);
  _hot_data0_free = PAGE_SIZE - (_hot_data0_end - _hot_data0_start);

  /*
   * A pinned slot holds one page, so a region spilling past one stops
   * being covered by the slot it was given.  That is silent at run
   * time, so fail here instead.  How many regions get pinned depends
   * on the MMU and is decided at boot, not here.
   */
  ASSERT(_hot_text0_end - _hot_text0_start <= PAGE_SIZE,
         "hot text region 0 exceeds one page")

  /*
   * Each tenant has to have arrived and to sit within the fewest lines
   * its size needs.  Both are judged from the recorded bounds rather
   * than from `.`, which does not hold the placement position when an
   * ASSERT inside an output section reads it.
   */
#define A(sym) HOT_CHECK(sym)
#define P(sym) HOT_CHECK(sym)
#define HOT_CHECK(sym) \
  ASSERT(_hot_end_##sym > _hot_at_##sym, \
         HOT_STR(sym did not land on the hot text page)) \
  ASSERT((_hot_end_##sym - 1) / COHERENCY_UNIT \
         - _hot_at_##sym / COHERENCY_UNIT \
         == (_hot_end_##sym - 1 - _hot_at_##sym) / COHERENCY_UNIT, \
         HOT_STR(sym straddles a cache line))
  HOT_TEXT_TENANTS
#undef A
#undef P

  ASSERT(_hot_data0_end - _hot_data0_start <= PAGE_SIZE,
         "hot data region 0 exceeds one page")
}
